{
  "name": "treaty-land-atlas",
  "version": "0.1.0",
  "private": true,
  "description": "Treaty Land Atlas: an interactive, time-aware map and knowledge graph of United States treaty law with Native nations. Created by Benjamin Life (@omniharmonic).",
  "author": "Benjamin Life (@omniharmonic)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-subdir pagefind",
    "preview": "astro preview",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "astro check && tsc --noEmit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "graph:build": "python3 scripts/build_graph.py",
    "data:ingest": "tsx pipeline/src/cli.ts ingest",
    "data:fetch": "tsx pipeline/src/cli.ts fetch",
    "data:restore": "tsx pipeline/src/cli.ts restore",
    "data:geometry": "tsx pipeline/src/cli.ts geometry",
    "data:emit": "tsx pipeline/src/cli.ts emit",
    "data:validate": "tsx pipeline/src/cli.ts validate",
    "data:build": "npm run graph:build && tsx pipeline/src/cli.ts build",
    "links:review": "tsx pipeline/src/cli.ts links-review",
    "release:check": "tsx pipeline/src/cli.ts release-check",
    "check:attribution": "node scripts/check-attribution.mjs",
    "check": "npm run lint && npm run typecheck && npm run test:unit",
    "test:e2e": "playwright test",
    "claims": "node scripts/claims.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "26.6.4",
    "@vercel/blob": "^2.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "astro": "7.3.5",
    "csv-parse": "7.0.3",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "eslint-plugin-svelte": "3.23.0",
    "globals": "17.13.0",
    "mapshaper": "^0.7.72",
    "mcp-handler": "2.3.0",
    "pagefind": "^1.5.2",
    "prettier": "3.9.9",
    "prettier-plugin-astro": "1.1.0",
    "prettier-plugin-svelte": "4.1.1",
    "subset-font": "^2.9.0",
    "svelte": "5.57.1",
    "svelte-check": "4.7.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "overrides": {
    "adm-zip": "0.6.1",
    "fflate": "0.8.3"
  },
  "dependencies": {
    "@fontsource/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource/noto-sans-cherokee": "^5.3.0",
    "@fontsource/noto-sans-osage": "^5.3.0",
    "maplibre-gl": "^6.11.2"
  }
}
