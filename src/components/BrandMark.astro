  aria-hidden="true"
  viewBox="0 0 48 48"
  fill="none"
>
  <path
    d="M27 5C36 5 39 13 36 21C33 29 28 37 18 36C8 35 5 28 8 19C10 11 17 5 27 5Z"
    stroke="currentColor"
    stroke-width="1.5"
  />
  <path
    d="M30 13C39 14 44 20 41 29C39 38 31 44 22 42C13 40 10 33 14 25C17 17 22 12 30 13Z"
    stroke="currentColor"
    stroke-width="1.5"
