---
import { incoming, node, outgoing, phrase, year, type Edge } from '../lib/graph';
import RelatedItem from './RelatedItem.astro';

interface Props {
  id: string;
  /** Edge types to leave out (shown elsewhere on the page). */
  skip?: string[];
  /** Cap per group; the rest go behind a details toggle. */
  limit?: number;
}
const { id, skip = ['evidenced_by', 'derived_from'], limit = 12 } = Astro.props;
type Row = { edge: Edge; other: NonNullable<ReturnType<typeof node>> };
const groups = new Map<string, Row[]>();
for (const [dir, list] of [
  ['out', outgoing(id)],
  ['in', incoming(id)],
] as const) {
  for (const e of list) {
    if (skip.includes(e.type)) continue;
    const other = node(dir === 'out' ? e.target : e.source);
    if (!other) continue;
    const key = `${dir}:${e.type}`;
    (groups.get(key) ?? groups.set(key, []).get(key)!).push({ edge: e, other });
  }
}
const sorted = [...groups.entries()]
  .map(([key, rows]) => {
    const [dir, type] = key.split(':') as ['out' | 'in', string];
    rows.sort(
      (a, b) =>
        (year(a.other) ?? 9999) - (year(b.other) ?? 9999) ||
        a.other.label.localeCompare(b.other.label),
    );
    // one row per related record, even when several links join the same pair
    const seen = new Set<string>();
    const unique = rows.filter((r) =>
      seen.has(r.other.id) ? false : (seen.add(r.other.id), true),
    );
    return { title: phrase(type, dir), type, rows: unique };
  })
  .sort((a, b) => b.rows.length - a.rows.length);
// when every link here is an automatic match, say so once instead of marking each one
const rowsAll = sorted.flatMap((g) => g.rows);
const allSuggested = rowsAll.length > 0 && rowsAll.every((r) => r.edge.status === 'proposed');
const someSuggested = rowsAll.some((r) => r.edge.status === 'proposed');
// a qualifier every row in a group shares goes once, beside the group's title
const ROLE_NOTE: Record<string, string> = {
  present_day_per_usfs: 'matched by the Forest Service, under review',
  named_in_royce_schedule: 'as named in the 1899 record',
};
const sharedRole = (rows: Row[]) => {
  const roles = new Set(rows.map((r) => r.edge.qualifiers?.['role']));
  const only = roles.size === 1 ? [...roles][0] : null;
  return typeof only === 'string' ? only : null;
};
---

{sorted.length > 0 && (
  <section class="connections" aria-labelledby={`conn-${id}`}>
    <h2 id={`conn-${id}`}>Connections</h2>
    {someSuggested && (
      <p class="small muted sans">
        {allSuggested
          ? 'These links were matched automatically by name or date and have not yet been reviewed by a person.'
          : 'Links marked “suggested” were matched automatically by name or date and have not yet been reviewed by a person.'}
      </p>
    )}
    {sorted.map((g) => {
      const role = sharedRole(g.rows);
      return (
        <section class="group">
          <h3>
            {g.title} <span class="count">{g.rows.length}</span>
            {role && ROLE_NOTE[role] && <span class="count">, {ROLE_NOTE[role]}</span>}
          </h3>
          <ul>
            {g.rows.slice(0, limit).map((r) => (
              <RelatedItem edge={r.edge} other={r.other} quiet={allSuggested} noRole={!!role} />
            ))}
          </ul>
          {g.rows.length > limit && (
            <details>
              <summary class="sans">Show all {g.rows.length}</summary>
              <ul>
                {g.rows.slice(limit).map((r) => (
                  <RelatedItem edge={r.edge} other={r.other} quiet={allSuggested} noRole={!!role} />
                ))}
              </ul>
            </details>
          )}
        </section>
      );
    })}
  </section>
)}

<style>
  .connections ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-3);
  }
  .group h3 {
    font-family: var(--sans);
    font-size: var(--s-1);
    font-weight: 600;
    color: var(--ink-2);
    margin: var(--space-5) 0 var(--space-2);
  }
  .count {
    font-weight: 400;
    color: var(--ink-3);
  }
  details summary {
    cursor: pointer;
    font-size: var(--s-1);
    color: var(--moss);
    min-height: 24px;
  }
</style>
