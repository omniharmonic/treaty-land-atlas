---
// Where this record's land is: its cessions on a quiet map of all of Royce's cessions, colored by
// how each was taken. Static SVG; the base map is one shared file.
import { incoming, outgoing, type Node } from '../lib/graph';
import { locatorMap } from '../lib/svgmap';
import LandShape from './LandShape.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import { HOW_LABEL, HOW_ORDER, type How } from '../islands/map/how';

interface Props {
  n: Node;
}
const { n } = Astro.props;
const stories = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'tables', 'cession-stories.json'), 'utf8'),
) as Record<string, { how: How; nations: string[]; instrument: string | null }>;
const ids = new Set<string>();
const ofInstrument = (i: string) =>
  incoming(i)
    .filter((e) => e.type === 'depicts')
    .forEach((e) => ids.add(e.source));
if (n.type === 'GeoFeature') ids.add(n.id);
if (n.type === 'Instrument') ofInstrument(n.id);
if (n.type === 'Nation') {
  const who = new Set([
    n.id,
    ...outgoing(n.id)
      .filter((e) => e.type === 'successor_of')
      .map((e) => e.target),
  ]);
  for (const [gid, s] of Object.entries(stories))
    if (s.nations.some((x) => who.has(x))) ids.add(gid);
}
if (n.type === 'Place')
  incoming(n.id)
    .filter((e) => e.type === 'located_in' && e.source.startsWith('geo-'))
    .forEach((e) => ids.add(e.source));
if (n.type === 'Violation')
  incoming(n.id)
    .filter((e) => e.type === 'violated_by')
    .forEach((e) => ofInstrument(e.source));
if (n.type === 'Case')
  outgoing(n.id)
    .filter((e) => e.type === 'concerns_instrument')
    .forEach((e) => ofInstrument(e.target));
const m = ids.size ? locatorMap(ids) : null;
const used = HOW_ORDER.filter((h) => m?.hi.some((x) => stories[x.id]?.how === h));
---

{m && m.hi.length > 0 && (
  <LandShape
    class="locator"
    ids={m.hi.map((x) => x.id)}
    fills={Object.fromEntries(
      m.hi.map((x) => [x.id, `var(--how-${stories[x.id]?.how ?? 'unknown'})`]),
    )}
    label={`Map of the ${m.hi.length === 1 ? 'land area' : `${m.hi.length} land areas`} connected to this record, colored by how the land was taken.`}
  >
    <figcaption>
      {used.map((h) => (
        <span class="key">
          <i style={`background: var(--how-${h})`} />
          {HOW_LABEL[h]}
        </span>
      ))}
      <span class="note">
        Shapes from the 1899 federal record: approximate, not legal boundaries.
      </span>
    </figcaption>
  </LandShape>
)}

<style>
  :global(.land.locator) {
    margin: var(--space-5) 0;
    max-width: 34rem;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    padding-top: var(--space-2);
  }
  .key i {
    display: inline-block;
    width: 0.8rem;
    height: 0.8rem;
    margin-right: var(--space-1);
    vertical-align: -0.05rem;
    border-radius: 2px;
  }
  .note {
    flex-basis: 100%;
  }
</style>
