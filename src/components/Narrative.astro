---
// "What happened": a plain-language reading of the sources for a federal record (treaty, case,
// violation), with the sources quoted beneath it. Written with AI assistance and labeled so.
// A nation's own story is never shown here; it waits for that nation's review.
import { overlayFor, type Node } from '../lib/graph';
import { href } from '../lib/href';

interface Props {
  n: Node;
  showHeadline?: boolean;
}
const { n, showHeadline = true } = Astro.props;
const o = overlayFor(n);
const paras = (o?.narrative ?? '')
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
const sources = (o?.sources ?? []).map((s) => (typeof s === 'string' ? { url: s } : s));
const host = (u: string) => {
  try {
    return new URL(u).hostname.replace(/^www\./, '');
  } catch {
    return u;
  }
};
const promises = o?.promises ?? [];
const KEPT: Record<string, string> = {
  kept: 'Kept',
  broken: 'Broken',
  partly: 'Partly kept',
  unknown: 'Not known',
};
const CONF: Record<string, string> = {
  high: 'Well supported by the sources below.',
  medium: 'Supported by the sources below; some details rest on one source.',
  low: 'Thinly sourced: read the sources and cautions before relying on this.',
};
---

{o && (
  <section class="narrative" aria-labelledby="what-happened">
    <h2 id="what-happened">What happened</h2>
    {showHeadline && o.headline && <p class="headline">{o.headline}</p>}
    {paras.map((p) => (
      <p>{p}</p>
    ))}
    {promises.length > 0 && (
      <section class="promises" aria-labelledby="promised">
        <h3 id="promised">What was promised, and what happened</h3>
        <ul>
          {promises.map((p) => (
            <li class={p.kept}>
              <span class="mark sans">{KEPT[p.kept]}</span>
              <div>
                <p class="what">
                  {p.promise}
                  {p.article && <span class="art sans"> ({p.article})</span>}
                </p>
                {p.evidence_quote && (
                  <p class="ev sans">
                    <q>{p.evidence_quote}</q>{' '}
                    {p.evidence_url && (
                      <a href={p.evidence_url} rel="noopener">
                        {host(p.evidence_url)}
                      </a>
                    )}
                  </p>
                )}
              </div>
            </li>
          ))}
        </ul>
      </section>
    )}
    {o.note && (
      <p class="note sans">
        <strong>Good to know.</strong> {o.note}
      </p>
    )}
    <p class="label sans">
      Summarized with AI assistance from {sources.length} source{sources.length === 1 ? '' : 's'}{' '}
      and checked against their words; not yet reviewed by historians or by the nations.{' '}
      <a href={href(`/corrections/?record=${encodeURIComponent(n.id)}`)}>Report an error</a>
    </p>
    {(sources.length > 0 || o.cautions) && (
      <details class="quotes sans">
        <summary>What the sources say, and how this was checked</summary>
        {o.confidence && <p class="conf">{CONF[o.confidence]}</p>}
        <ol>
          {sources.map((s) => (
            <li>
              {s.quote && <q>{s.quote}</q>}
              <a href={s.url} rel="noopener">
                {s.title ?? host(s.url)}
              </a>
            </li>
          ))}
        </ol>
        {o.cautions && (
          <p class="cautions">
            <strong>Research notes.</strong> {o.cautions}
          </p>
        )}
      </details>
    )}
  </section>
)}

<style>
  .promises h3 {
    font-size: var(--s1);
    margin: var(--space-5) 0 var(--space-2);
  }
  .promises ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }
  .promises li {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: var(--space-3);
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }
  .mark {
    font-size: var(--s-1);
    font-weight: 600;
    align-self: start;
    padding: 2px var(--space-2);
    border-left: 4px solid var(--rule-strong);
  }
  .broken .mark {
    border-left-color: var(--fam-taken-ink);
  }
  .partly .mark {
    border-left-color: var(--fam-ceded-ink);
  }
  .kept .mark {
    border-left-color: var(--ls-reserved);
  }
  .what {
    margin: 0;
  }
  .art,
  .ev {
    font-size: var(--s-1);
    color: var(--ink-2);
  }
  .ev {
    margin: var(--space-1) 0 0;
  }
  .narrative {
    margin: var(--space-6) 0;
    max-width: var(--measure);
  }
  .headline {
    font-size: var(--s1);
    line-height: 1.35;
  }
  .note {
    font-size: var(--s-1);
    background: var(--ochre);
    border-radius: 10px;
    padding: var(--space-3) var(--space-4);
    max-width: none;
  }
  .conf {
    font-size: var(--s-1);
    color: var(--ink-2);
  }
  .label,
  .cautions {
    font-size: var(--s-1);
    color: var(--ink-2);
  }
  .label {
    padding-left: var(--space-3);
    border-left: 3px solid var(--lichen);
  }
  .quotes summary {
    cursor: pointer;
    font-size: var(--s-1);
    font-weight: 600;
  }
  .quotes ol {
    padding-left: var(--space-5);
    font-size: var(--s-1);
  }
  .quotes li {
    margin: var(--space-2) 0;
  }
  .quotes q {
    display: block;
    font-family: var(--serif);
    font-size: var(--s0);
    color: var(--ink);
  }
</style>
