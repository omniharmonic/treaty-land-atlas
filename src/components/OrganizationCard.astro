---
import BrandMark from './BrandMark.astro';
import { focusLine, type SupportOrg } from '../lib/support';
import { href } from '../lib/href';
interface Props {
  org: SupportOrg;
}
const { org } = Astro.props;
const kind = {
  native: 'Native-led organization',
  nation: 'Nation government',
  ally: 'Allied land trust',
};
---

<article class="organization-card">
  <div class="org-top">
    <span class="org-symbol" aria-hidden="true">
      <BrandMark />
    </span>
    <span>{kind[org.kind]}</span>
  </div>
  <h3>
    <a href={href(org.path ?? '/support/')}>{org.label}</a>
  </h3>
  <p>{focusLine(org.focus)}</p>
  <div class="org-actions">
    {org.website && (
      <a href={org.website} rel="noopener">
        Explore their work <span aria-hidden="true">↗</span>
      </a>
    )}
    {org.donate && (
      <a class="org-give" href={org.donate} rel="noopener">
        Give directly <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</article>
<style>
  .organization-card {
    display: flex;
    flex-direction: column;
    padding: 30px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 16px;
    min-width: 0;
  }
  .org-top {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: var(--s-2);
    color: var(--ink-2);
    margin-bottom: 30px;
  }
  .org-symbol {
    width: 46px;
    height: 46px;
    background: var(--org-symbol);
    border-radius: 12px;
    color: var(--moss);
    flex: none;
  }
  .org-symbol :global(svg) {
    width: 100%;
    height: 100%;
    padding: 5px;
  }
  h3 {
    font-family: var(--sans);
    font-weight: 400;
    font-size: 1.65rem;
    line-height: 1.15;
    letter-spacing: -0.025em;
    margin: 0 0 16px;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--moss);
    text-decoration: underline;
  }
  p {
    font-size: 0.95rem;
    color: var(--ink-2);
    line-height: 1.6;
    margin: 0 0 28px;
  }
  .org-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
    font-size: 0.875rem;
  }
  .org-actions a {
    display: inline-flex;
    gap: 8px;
    align-items: center;
    text-decoration: none;
    min-height: 28px;
  }
  .org-give {
    margin-left: auto;
  }
  @media (max-width: 600px) {
    .organization-card {
      padding: 24px;
    }
  }
</style>
