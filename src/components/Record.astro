---
import { REVIEW_WORD, TYPE_NAME, cleanTags, type Node } from '../lib/graph';
import { STATUS_WORD, factsFor } from '../lib/facts';
import { node as nodeById, pathFor } from '../lib/graph';
import { href } from '../lib/href';
import Connections from './Connections.astro';
import Sources from './Sources.astro';
import SpecimenLabel from './SpecimenLabel.astro';
import ClaimBox from './ClaimBox.astro';
import SupportBox from './SupportBox.astro';
import Narrative from './Narrative.astro';
import RecordStory from './RecordStory.astro';
import LocatorMap from './LocatorMap.astro';
import NationTimeline from './NationTimeline.astro';

interface Props {
  n: Node;
  kicker?: string;
}
const { n, kicker } = Astro.props;
const facts = factsFor(n);
const isNationSpecific = n.tribal_review?.scope === 'nation_specific';
const status = n.tribal_review?.status ?? 'not_yet_contacted';
const summary = n.summary ? cleanTags(n.summary) : null;
const notes = n.notes ? cleanTags(n.notes) : null;
type Name = {
  name: string;
  kind: string;
  source_url?: string | null;
  language_or_script?: string | null;
};
// All-lowercase entries without a source are alias match keys from the crosswalk, not names
// anyone writes; keep them for search but not for display.
const names = ((n['names'] as Name[]) ?? []).filter(
  (x) =>
    x.kind !== 'preferred_label' &&
    !(x.name === x.name.toLowerCase() && !x.source_url && /[a-z]/.test(x.name)),
);
const nameGroups: [string, string[]][] = [
  ['Self-names', ['endonym', 'endonym_per_seed']],
  ['Official names', ['official_name']],
  ['Names in treaties and records', ['source_label', 'exonym', 'historical_spelling']],
  ['Other names in English', ['common_english']],
  ['Peoples within this name', ['related_people']],
];
// every name and alias, plus forms without diacritics, so search finds "Dakota" for "Dakȟóta"
const allNames = [
  ...((n['names'] as Name[]) ?? []).map((x) => x.name),
  ...((n['aliases'] as string[]) ?? []),
  String(n['official_name'] ?? ''),
].filter(Boolean);
const searchNames = [
  ...new Set([...allNames, ...allNames.map((x) => x.normalize('NFKD').replace(/\p{M}/gu, ''))]),
].join(' · ');
type RecRecord = {
  status: string;
  detail?: string | null;
  where?: string | null;
  year?: string | null;
  source_url: string;
};
const records = ((n['recognition_records'] as RecRecord[]) ?? []).filter((r) => r.source_url);
const disputedWith = ((n['disputed_with'] as string[]) ?? [])
  .map((id) => nodeById(id))
  .filter(Boolean);
type Correction = {
  field: string;
  as_listed: unknown;
  source_url: string;
  evidence_quote?: string | null;
};
const corrections = ((n['corrections'] as Correction[]) ?? []).filter((c) =>
  /^https?:/.test(c.source_url),
);
const FIELD_WORD: Record<string, string> = {
  date_signed: 'The signing date',
  label: 'The title',
  land_description: 'The land description',
  summary: 'The summary',
  notes: 'A note',
  start_year: 'The year',
  website: 'The website',
  indigenous_led: 'Native leadership',
  holding_summary: 'The holding',
  treaty_at_issue_text: 'The treaty at issue',
};
const flagText: Record<string, string> = {
  'from-memory': 'not yet checked against a source',
  unverified: 'unverified',
  disputed: 'disputed',
};
---

<article class="record" data-pagefind-body>
  <div>
    <p class="kicker sans" data-pagefind-filter="kind">
      {kicker ?? TYPE_NAME[n.type]?.[0]}
    </p>
    <span class="visually-hidden">{searchNames}</span>
    <h1>{n.label}</h1>
    {isNationSpecific && (
      <p class:list={['review-note', 'sans', status]}>
        {REVIEW_WORD[status] ?? status}.{' '}
        {status === 'not_yet_contacted' &&
          'What follows comes from public records and research. It does not speak for the nation.'}
      </p>
    )}
    {summary?.text && <p class="lede">{summary.text}</p>}

    <Narrative n={n} />
    <RecordStory n={n} />
    <LocatorMap n={n} />
    {n.type === 'Nation' && <NationTimeline n={n} />}

    {facts.length > 0 && (
      <dl class="facts">
        {facts.map((fct) => (
          <div>
            <dt class="sans">{fct.label}</dt>
            <dd>
              {fct.href ? <a href={fct.href}>{fct.value}</a> : fct.value}
              {(fct.flags ?? []).map((fl) => (
                <span class="flag sans">{flagText[fl] ?? fl}</span>
              ))}
            </dd>
          </div>
        ))}
      </dl>
    )}

    {n.type === 'Nation' && names.length > 0 && (
      <section aria-labelledby="names">
        <h2 id="names">Names</h2>
        <p class="small muted sans">
          Each name shows where it comes from. A nation’s own name is shown as the nation writes it.
        </p>
        {nameGroups.map(([title, kinds]) => {
          const list = names.filter((x) => kinds.includes(x.kind));
          const seen = new Set<string>();
          const unique = list.filter((x) => {
            const k = x.name.toLowerCase();
            return seen.has(k) ? false : (seen.add(k), true);
          });
          return (
            unique.length > 0 && (
              <div class="names">
                <h3>{title}</h3>
                <ul>
                  {unique.map((x) => (
                    <li lang={x.kind.startsWith('endonym') ? 'und' : undefined}>
                      {x.source_url ? <a href={x.source_url}>{x.name}</a> : x.name}
                      {x.language_or_script && !/^(en|english)$/i.test(x.language_or_script) && (
                        <span class="lang sans">{x.language_or_script}</span>
                      )}
                    </li>
                  ))}
                </ul>
              </div>
            )
          );
        })}
      </section>
    )}

    {records.length > 0 && (
      <section aria-labelledby="status">
        <h2 id="status">Recognition, as each source states it</h2>
        <p class="small muted sans">
          Recognition is a legal and political status that governments assign; it is not a measure
          of who a people are.
        </p>
        <ul class="records">
          {records.map((r) => (
            <li>
              <strong>{STATUS_WORD[r.status] ?? r.status.replace(/_/g, ' ')}</strong>
              {r.where && `, ${r.where}`}
              {r.year && ` (${r.year})`}
              {r.detail && <span class="detail">{r.detail}</span>}
              <a class="src sans" href={r.source_url}>
                source
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
    {disputedWith.length > 0 && (
      <p class="review-note sans">
        Disputed: another organization claims the same people or history:{' '}
        {disputedWith.map((d, i) => (
          <>
            {i > 0 && ', '}
            <a href={href(pathFor(d!) ?? '/')}>{d!.label}</a>
          </>
        ))}
        . We show each claim and do not choose between them.
      </p>
    )}

    <slot />

    <SupportBox n={n} />

    {corrections.length > 0 && (
      <section aria-labelledby="corrections-h">
        <h2 id="corrections-h">Corrections to this record</h2>
        <ul class="small">
          {corrections.map((c) => (
            <li>
              {FIELD_WORD[c.field] ?? c.field.replace(/_/g, ' ')} was listed as “
              {String(c.as_listed ?? '')}”; corrected from{' '}
              <a href={c.source_url}>{new URL(c.source_url).hostname.replace(/^www\./, '')}</a>
              {c.evidence_quote && <q>{c.evidence_quote}</q>}
            </li>
          ))}
        </ul>
      </section>
    )}

    {notes?.text && (
      <section>
        <h2>Research notes</h2>
        <p>{notes.text}</p>
      </section>
    )}

    <Connections id={n.id} />
    <Sources id={n.id} />
  </div>
  <aside aria-label="About this record">
    <SpecimenLabel n={n} />
    {n.type === 'Nation' && <ClaimBox n={n} />}
  </aside>
</article>

<style>
  .record > div {
    min-width: 0;
  }
  .kicker {
    font-size: var(--s-1);
    color: var(--ink-2);
    margin: 0 0 var(--space-2);
  }
  .review-note {
    font-size: var(--s-1);
    color: var(--ink-2);
    padding-left: var(--space-3);
    border-left: 3px solid var(--lichen);
  }
  .review-note.reviewed,
  .review-note.co_authored {
    border-left-color: var(--moss);
  }
  .facts {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-5) 0;
  }
  .facts > div {
    display: grid;
    gap: var(--space-1) var(--space-5);
  }
  @media (min-width: 640px) {
    .facts > div {
      grid-template-columns: 11rem minmax(0, 1fr);
    }
  }
  .facts dt {
    font-size: var(--s-1);
    color: var(--ink-3);
    padding-top: 0.15em;
  }
  .facts dd {
    margin: 0;
    max-width: var(--measure);
  }
  .flag {
    display: inline-block;
    margin-left: var(--space-2);
    font-size: var(--s-2);
    color: var(--warn);
    border-bottom: 1px dotted currentColor;
  }
  .names h3 {
    font-family: var(--sans);
    font-size: var(--s-1);
    font-weight: 600;
    color: var(--ink-2);
    margin: var(--space-4) 0 var(--space-1);
  }
  .names ul {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-5);
  }
  .records {
    list-style: none;
    padding: 0;
  }
  .records li {
    margin-bottom: var(--space-3);
  }
  .records .detail {
    display: block;
    color: var(--ink-2);
    font-size: var(--s-1);
  }
  .src {
    font-size: var(--s-2);
    margin-left: var(--space-2);
  }
  .lang {
    font-size: var(--s-2);
    color: var(--ink-3);
    margin-left: var(--space-2);
  }
</style>
