---
// The support box on every record page: the nations today and the organizations doing the work,
// found by walking the graph from this record (src/lib/support.ts).
import { graph, incoming, outgoing, type Node } from '../lib/graph';
import { concerns, supportFor, supportIndex, type SupportIndex } from '../lib/support';
import SupportView from './SupportView.svelte';

interface Props {
  n: Node;
  titled?: boolean;
}
const { n, titled = true } = Astro.props;
const g = graph();
const ix: SupportIndex = ((globalThis as { __supportIx?: SupportIndex }).__supportIx ??=
  supportIndex([...g.nodes.values()], g.edges));
const result = supportFor(ix, concerns(n.id, n.type, outgoing, incoming));
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

{n.type !== 'Organization' && <SupportView {base} {ix} {result} {titled} />}
