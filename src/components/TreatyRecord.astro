---
// A treaty, told in the order a newcomer needs it: what it was and what happened, the nations, what
// it did to the land, what happened to that land afterwards, the courts and laws that followed, who
// is doing the work today, and the evidence. Every sentence comes from the linked records.
import type { Node } from '../lib/graph';
import { graph, overlayFor, cleanTags } from '../lib/graph';
import { treatyExperience } from '../lib/treaty';
import { acresText, landTotals, ROLE_KIND, ROLE_PHRASE, treatyLand } from '../lib/land';
import { href } from '../lib/href';
import Narrative from './Narrative.astro';
import Sources from './Sources.astro';
import SupportBox from './SupportBox.astro';
import SpecimenLabel from './SpecimenLabel.astro';
import RecordCorrections from './RecordCorrections.astro';
import LandShape from './LandShape.astro';
import TreatyTimeline from './TreatyTimeline.astro';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

interface Props {
  n: Node;
}
const { n } = Astro.props;
const g = graph();
const experience = treatyExperience(n, [...g.nodes.values()], g.edges);
const { areas, steps } = treatyLand(n);
const totals = landTotals(areas);
const overlay = overlayFor(n);
const headlines = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'tables', 'headlines.json'), 'utf8'),
) as Record<string, string>;
const status = String(n['ratification_status'] ?? 'unknown');
const MONTHS =
  'January February March April May June July August September October November December'.split(
    ' ',
  );
const fmt = (d: unknown) => {
  const m = String(d ?? '').match(/^(\d{4})-(\d{2})-(\d{2})/);
  return m ? `${MONTHS[Number(m[2]) - 1]} ${Number(m[3])}, ${m[1]}` : d ? String(d) : null;
};
const promises = overlay?.promises ?? [];
const broken = promises.filter((p) => p.kept === 'broken' || p.kept === 'partly').length;
const glance: [string, string][] = [
  ['Signed', fmt(n['date_signed']) ?? 'Date not recorded'],
  [
    'Senate',
    status === 'unratified'
      ? 'Never ratified'
      : n['date_ratified']
        ? `Ratified ${fmt(n['date_ratified'])}`
        : status.startsWith('ratified')
          ? 'Ratified'
          : 'Not recorded',
  ],
];
if (totals.lost) glance.push(['Land given up', acresText(totals.lost)]);
if (totals.kept) glance.push(['Land set aside for the nations', acresText(totals.kept)]);
if (promises.length)
  glance.push(['Promises', `${broken} of ${promises.length} broken or only partly kept`]);
const lawKinds: Record<string, string> = {
  Case: 'Court case',
  Statute: 'Law',
  Doctrine: 'Legal doctrine',
  Instrument: 'Related agreement',
};
// the hero map colors each area by what this treaty did to it: given up, or kept
const heroFills = Object.fromEntries(
  areas
    .filter((a) => a.role)
    .map((a) => [a.id, ROLE_KIND[a.role!] === 'lost' ? '#9d6b4b' : '#6f8a5a']),
);
// cases, laws and agreements with a date already sit in "What happened next"; this section keeps
// what the timeline does not show (the legal doctrines, and anything without a year)
const inTimeline = new Set(experience.events.map((e) => e.id));
const law = experience.related.filter((l) => lawKinds[l.type] && !inTimeline.has(l.id));
const notes = cleanTags(n.notes);
const suggested = experience.nations.some((x) => x.suggested);
const fullMap = areas[0] ? `/map/#sel=${encodeURIComponent(areas[0].id)}` : '/map/';
const who = experience.nations.map((x) => x.label);
const landLabel = `Map of the land in this treaty’s record: ${areas.length} area${areas.length === 1 ? '' : 's'}${who.length ? ` connected to ${who.slice(0, 3).join(', ')}` : ''}.`;
---

<article class="treaty-record" data-pagefind-body>
  <a class="back-link" href={href('/treaties/')}>
    <span aria-hidden="true">←</span> All treaties and agreements
  </a>
  <header class:list={['hero', { 'with-land': areas.length > 0 }]}>
    <div class="hero-text">
      <p class="meta">
        <span>{String(n['region'] ?? '')}</span>
        <span class:list={['pill', { unratified: status === 'unratified' }]}>
          {status === 'unratified' ? 'Never ratified' : 'Treaty'}
        </span>
      </p>
      <h1>{n.label}</h1>
      {overlay?.headline && <p class="headline">{overlay.headline}</p>}
      <dl class="glance">
        {glance.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
    {areas.length > 0 && (
      <LandShape
        ids={areas.map((a) => a.id)}
        fills={heroFills}
        tone="quiet"
        label={landLabel}
        class="hero-land"
      >
        <figcaption>
          The land in this treaty’s record. <a href={href(fullMap)}>Open on the map</a>
        </figcaption>
      </LandShape>
    )}
  </header>
  {status === 'unratified' && (
    <p class="unratified-note">
      The Senate never ratified this treaty, so under U.S. law it never took effect, even when the
      government acted on it.
    </p>
  )}

  <nav class="record-nav" aria-label="On this page">
    <a href="#story">What happened</a>
    {areas.length > 0 && <a href="#land">The land</a>}
    <a href="#after">What happened next</a>
    {law.length > 0 && <a href="#law">The law behind it</a>}
    <a href="#work">Who is doing the work</a>
    <a href="#evidence">Sources</a>
  </nav>

  <section id="story" class="story" aria-labelledby="story-h">
    <div class="reading">
      <h2 id="story-h" class="visually-hidden">
        What happened
      </h2>
      {overlay ? (
        <Narrative {n} showHeadline={false} />
      ) : (
        <p class="gap">
          The story of this treaty has not been written up yet. Its dates, its land and what came
          after are below, with the sources.
        </p>
      )}
    </div>
    <aside class="people" aria-labelledby="nations-h">
      <h2 id="nations-h">The nations</h2>
      {experience.nations.length ? (
        <ul>
          {experience.nations.map((nation) => (
            <li>{nation.path ? <a href={href(nation.path)}>{nation.label}</a> : nation.label}</li>
          ))}
        </ul>
      ) : (
        <p class="small">Not yet linked to a present-day nation.</p>
      )}
      <p class="small">
        As named in the treaty: {cleanTags(n['parties_text']).text || 'not recorded'}.
      </p>
      <p class="small">
        {suggested &&
          'Some links between treaty names and present-day nations are matched by name and not yet confirmed. '}
        This page draws on public records and has not been reviewed by the nations.{' '}
        <a href={href('/claim/')}>Nations can review or correct it</a>.
      </p>
    </aside>
  </section>

  {areas.length > 0 && (
    <section id="land" class="land-section" aria-labelledby="land-h">
      <h2 id="land-h">What the treaty did to the land</h2>
      <p class="section-lede">
        {totals.lost > 0 && <>{acresText(totals.lost).replace(/^about/, 'About')} given up. </>}
        {totals.kept > 0 && (
          <>
            {acresText(totals.kept).replace(/^about/, totals.lost ? 'about' : 'About')} recognized,
            kept or set aside for the nations.{' '}
          </>
        )}
        Each shape is a numbered area in the federal government’s 1899 record of land cessions.
      </p>
      <ul class="areas">
        {areas.map((a) => (
          <li>
            <LandShape
              ids={[a.id]}
              tone={
                a.role && ['ceded', 'ceded_part', 'retroceded', 'us_reserved'].includes(a.role)
                  ? 'lost'
                  : a.role
                    ? 'kept'
                    : 'quiet'
              }
              label={`Outline of ${a.label}`}
              links={false}
            />
            <div>
              <p class="role">
                {a.role ? ROLE_PHRASE[a.role] : 'Linked to this treaty'}
                {a.acres > 0 && <span>{acresText(a.acres)}</span>}
              </p>
              <h3>
                <a href={a.href ? href(a.href) : undefined}>{a.label}</a>
              </h3>
              {a.summary && <p class="sum">{a.summary}</p>}
            </div>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="after" class="after-section" aria-labelledby="after-h">
    <h2 id="after-h">What happened next</h2>
    <p class="section-lede">
      Everything the record holds about this land and this treaty, in order: what earlier agreements
      said, what this one did, and what the United States, the courts and the nations did
      afterwards.
    </p>
    <TreatyTimeline {n} {areas} {steps} events={experience.events} />
  </section>

  {law.length > 0 && (
    <section id="law" class="law-section" aria-labelledby="law-h">
      <h2 id="law-h">The law behind it</h2>
      <p class="section-lede">
        The legal ideas behind the decisions, and related records without a date. Court cases and
        laws with a date are in what happened next, above.
      </p>
      <ul class="law">
        {law.map((l) => (
          <li>
            <p class="kind">{lawKinds[l.type]}</p>
            <h3>{l.path ? <a href={href(l.path)}>{l.label}</a> : l.label}</h3>
            {headlines[l.id] && <p>{headlines[l.id]}</p>}
          </li>
        ))}
      </ul>
    </section>
  )}

  <section id="work" class="work-section" aria-labelledby="work-h">
    <h2 id="work-h">Who is doing the work today</h2>
    <p class="section-lede">
      The nations connected to this treaty come first, then groups returning land and defending
      treaty rights. Support goes directly to them.
    </p>
    <SupportBox {n} titled={false} />
  </section>

  <section id="evidence" class="evidence" aria-labelledby="evidence-h">
    <div>
      <h2 id="evidence-h">Sources</h2>
      <Sources id={n.id} titled={false} />
      <RecordCorrections {n} />
      {notes.text && (
        <details>
          <summary>Research notes</summary>
          <p>{notes.text}</p>
        </details>
      )}
      <p class="small">
        Shapes are approximate and are not legal descriptions of land, title or jurisdiction.
      </p>
    </div>
    <aside aria-label="About this record">
      <SpecimenLabel {n} />
    </aside>
  </section>
</article>

<style>
  .treaty-record {
    padding-top: 32px;
  }
  .back-link {
    display: inline-flex;
    gap: 12px;
    font-size: 0.8rem;
    text-decoration: none;
  }
  .hero {
    display: grid;
    gap: 48px;
    align-items: center;
    padding: 40px 0 48px;
  }
  @media (min-width: 900px) {
    .hero.with-land {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 20px;
    font-size: 0.8rem;
    color: var(--ink-2);
    margin: 0 0 20px;
  }
  .meta span:empty {
    display: none;
  }
  .pill {
    background: var(--sage);
    border-radius: 30px;
    padding: 4px 12px;
    color: var(--moss-deep);
  }
  .pill.unratified {
    background: var(--clay);
    color: #774e35;
  }
  h1 {
    font-size: clamp(2.3rem, 4.5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.045em;
    margin: 0 0 20px;
    max-width: 22ch;
  }
  .headline {
    max-width: 58ch;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--ink-2);
    margin: 0;
  }
  .glance {
    display: flex;
    flex-wrap: wrap;
    gap: 16px 36px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--rule);
  }
  .glance dt {
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--ink-2);
  }
  .glance dd {
    margin: 2px 0 0;
    font-size: var(--s0);
  }
  .hero :global(.hero-land) {
    align-self: stretch;
  }
  .unratified-note {
    padding: 16px 22px;
    background: var(--ochre);
    border-radius: 10px;
    font-size: 0.95rem;
    max-width: none;
  }
  .record-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
    padding: 16px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .record-nav a {
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .record-nav a:hover {
    text-decoration: underline;
  }
  section[id] {
    scroll-margin-top: 24px;
  }
  h2 {
    font-size: clamp(1.8rem, 3vw, 2.5rem);
    letter-spacing: -0.035em;
    line-height: 1.1;
    margin: 0 0 16px;
  }
  .section-lede {
    color: var(--ink-2);
    max-width: 62ch;
    margin: 0 0 32px;
  }
  .story {
    display: grid;
    gap: 48px;
    padding: 56px 0;
  }
  @media (min-width: 900px) {
    .story {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 8%;
    }
  }
  .reading {
    min-width: 0;
  }
  .reading :global(.narrative > h2) {
    display: none;
  }
  .reading :global(.narrative p:first-of-type) {
    margin-top: 0;
  }
  .reading :global(.promises li) {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 20px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 12px;
    margin-top: 12px;
  }
  .reading :global(.mark) {
    font-weight: 400;
    border: 0;
    padding: 4px 10px;
    width: fit-content;
    border-radius: 20px;
    background: var(--sheet-2);
  }
  .reading :global(.broken .mark) {
    background: var(--clay);
    color: #774e35;
  }
  .reading :global(.kept .mark) {
    background: var(--sage);
    color: var(--moss-deep);
  }
  .reading :global(.partly .mark) {
    background: var(--ochre);
    color: #6c572b;
  }
  .gap {
    background: var(--sheet-2);
    border-radius: 12px;
    padding: 24px;
  }
  .people {
    background: var(--sheet-2);
    border-radius: 16px;
    padding: 24px 28px;
    align-self: start;
  }
  .people h2 {
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .people ul {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }
  .people li {
    border-top: 1px solid var(--rule-strong);
    padding: 12px 0;
  }
  .small {
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--ink-2);
    line-height: 1.55;
  }
  .land-section,
  .after-section,
  .law-section,
  .work-section {
    padding: 56px 0;
    border-top: 1px solid var(--rule);
  }
  .areas {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 20px;
  }
  .areas li {
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 14px;
    overflow: hidden;
    max-width: none;
  }
  .areas li :global(.land) {
    border-radius: 0;
  }
  @media (max-width: 600px) {
    .areas {
      gap: 12px;
    }
    .areas li {
      display: grid;
      grid-template-columns: 104px minmax(0, 1fr);
      align-items: start;
    }
    .areas li :global(.land) {
      height: 100%;
    }
    .areas li :global(.inset) {
      display: none;
    }
    .areas li > div {
      padding: 12px 14px;
    }
    .areas .sum {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    .law li {
      padding: 14px 16px;
    }
  }
  .areas li > div {
    padding: 16px 18px 18px;
  }
  .role {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 12px;
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--moss);
    margin: 0 0 6px;
  }
  .role span {
    color: var(--ink-2);
  }
  .areas h3 {
    font-size: var(--s0);
    line-height: 1.35;
    margin: 0;
  }
  .areas h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .areas h3 a:hover {
    text-decoration: underline;
  }
  .sum {
    font-size: var(--s-1);
    color: var(--ink-2);
    line-height: 1.5;
    margin: 8px 0 0;
  }
  .law {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .law li {
    max-width: none;
    padding: 20px 22px;
    border: 1px solid var(--rule);
    border-radius: 12px;
    background: var(--sheet);
  }
  .law .kind {
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--moss);
    margin: 0 0 6px;
  }
  .law h3 {
    font-size: 1.05rem;
    line-height: 1.35;
    margin: 0;
  }
  .law h3 a {
    color: var(--ink);
  }
  .law li > p:last-child:not(.kind) {
    font-size: var(--s-1);
    color: var(--ink-2);
    margin: 8px 0 0;
  }
  .work-section :global(.support) {
    margin-top: 0;
  }
  .evidence {
    display: grid;
    gap: 40px;
    padding: 56px 0 0;
    border-top: 1px solid var(--rule);
  }
  @media (min-width: 900px) {
    .evidence {
      grid-template-columns: minmax(0, 1fr) 300px;
      gap: 8%;
    }
  }
  .evidence > div {
    min-width: 0;
  }
  .evidence :global(h2:not(#evidence-h)) {
    font-size: 1.2rem;
    margin-top: 28px;
  }
  details {
    font-size: 0.9rem;
    padding: 14px 0;
    border-top: 1px solid var(--rule);
  }
  summary {
    color: var(--moss);
    cursor: pointer;
    min-height: 28px;
  }
</style>
