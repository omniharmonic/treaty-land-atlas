---
import type { Node } from '../lib/graph';
import { graph, overlayFor, cleanTags } from '../lib/graph';
import { treatyExperience } from '../lib/treaty';
import { locatorMap } from '../lib/svgmap';
import { href } from '../lib/href';
import TreatyJourney from '../islands/TreatyJourney.svelte';
import Narrative from './Narrative.astro';
import Sources from './Sources.astro';
import SupportBox from './SupportBox.astro';
import SpecimenLabel from './SpecimenLabel.astro';
import BrandMark from './BrandMark.astro';
import RecordCorrections from './RecordCorrections.astro';
interface Props {
  n: Node;
}
const { n } = Astro.props;
const g = graph();
const experience = treatyExperience(n, [...g.nodes.values()], g.edges);
const geometryIds = [
  ...new Set([...experience.geometryIds, ...experience.events.flatMap((e) => e.geometryIds)]),
];
const map = locatorMap(geometryIds);
const overlay = overlayFor(n);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const status = String(n['ratification_status'] ?? 'unknown');
const statuses: Record<string, string> = {
  ratified: 'Ratified',
  ratified_with_amendments: 'Ratified with amendments',
  unratified: 'Never ratified',
  not_applicable: 'Ratification not applicable',
};
const kindNames: Record<string, string> = {
  Case: 'Court decision',
  Statute: 'Legislation',
  Doctrine: 'Legal principle',
  Campaign: 'Land return',
  Instrument: 'Related agreement',
  Violation: 'Related history',
};
const notes = cleanTags(n.notes);
const fullMap = experience.geometryIds[0]
  ? `/map/#sel=${encodeURIComponent(experience.geometryIds[0])}`
  : '/map/';
---

<article class="treaty-record" data-pagefind-body>
  <a class="back-link" href={href('/treaties/')}>
    <span aria-hidden="true">←</span> All treaties and agreements
  </a>
  <header class="treaty-hero">
    <div>
      <div class="treaty-meta">
        <span>{n['date_signed'] ? String(n['date_signed']) : 'Date not recorded'}</span>
        <span>{String(n['region'] ?? 'Region not recorded')}</span>
        <span class:list={['ratification', { unratified: status === 'unratified' }]}>
          {statuses[status] ?? 'Ratification not recorded'}
        </span>
      </div>
      <h1>{n.label}</h1>
      <p class="hero-description">
        {overlay?.headline ??
          'Explore this agreement through its recorded terms, the people and land it concerns, and the history linked to it.'}
      </p>
    </div>
    <div class="hero-aside">
      <BrandMark class="record-mark" />
      <p>
        Written into law.
        <br />
        Still present in the land.
      </p>
      <a href="#take-action">
        Connect with the work <span aria-hidden="true">↗</span>
      </a>
    </div>
  </header>
  {status === 'unratified' && (
    <p class="unratified-note">
      This instrument was never ratified. Signing and ratification are different; its presence here
      does not mean it became a ratified U.S. treaty.
    </p>
  )}
  <nav class="record-nav" aria-label="On this treaty page">
    <a href="#the-promise">The agreement</a>
    <a href="#history">
      What followed <span>{experience.events.length}</span>
    </a>
    <a href="#connections">Connected histories</a>
    <a href="#take-action">The work today</a>
    <a href="#evidence">Sources and record</a>
  </nav>
  <section id="the-promise" class="promise-section" aria-labelledby="promise-title">
    <div class="reading-column">
      <p class="section-note">The agreement</p>
      <h2 id="promise-title">Begin with the promise.</h2>
      {overlay ? (
        <Narrative {n} showHeadline={false} />
      ) : (
        <div class="research-gap">
          <h3>A fuller reading is still to come.</h3>
          <p>
            This agreement does not yet have a published narrative or article-by-article account.
            Explore the recorded terms and dates in the timeline, and consult the sources below.
          </p>
          <p>We do not treat missing research as evidence that a promise was kept or broken.</p>
        </div>
      )}
      <details class="parties-record">
        <summary>Parties as named in the original record</summary>
        <p>{cleanTags(n['parties_text']).text || 'The parties have not been recorded here yet.'}</p>
        <p class="small muted">
          Historical labels can differ from a nation’s own name and from present-day governments.
          The linked nation records show those distinctions.
        </p>
      </details>
    </div>
    <aside class="people-aside" aria-labelledby="nations-h">
      <p class="section-note">The people in the record</p>
      <h3 id="nations-h">
        Living nations.
        <br />
        Continuing histories.
      </h3>
      {experience.nations.length ? (
        <ul class="nation-links">
          {experience.nations.map((nation) => (
            <li>
              {nation.path ? (
                <a href={href(nation.path)}>
                  {nation.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                <span>{nation.label}</span>
              )}
              {nation.suggested && <small>Suggested name match; not reviewed by the nation.</small>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="small muted">
          Nation connections have not been established for this agreement yet. Consult the parties
          as recorded.
        </p>
      )}
      <p class="small muted">
        This account draws on public records. It does not speak for the nations involved and has not
        been reviewed by them.
      </p>
      <a class="small" href={href('/claim/')}>
        For nations: review or correct this account
      </a>
    </aside>
  </section>
  <section id="history" class="history-section" aria-labelledby="history-title">
    <div class="section-heading">
      <div>
        <p class="section-note">The record unfolds</p>
        <h2 id="history-title">What followed.</h2>
      </div>
      <p>
        Move between the agreement, land records, and legal history. Explore each connection on its
        own terms.
      </p>
    </div>
    <TreatyJourney client:load events={experience.events} {map} {base} />
    <noscript>
      <p>The interactive timeline needs JavaScript. Every linked entry remains available here:</p>
      <ul>
        {experience.events
          .filter((e) => e.path && e.id !== 'signed' && e.id !== 'ratified')
          .map((e) => (
            <li>
              <a href={href(e.path!)}>
                {e.date}: {e.label}
              </a>
              {e.suggested ? ' (suggested connection)' : ''}
              {e.context ? ' (related context)' : ''}
            </li>
          ))}
      </ul>
    </noscript>
  </section>
  <section id="connections" class="connections-section" aria-labelledby="connections-title">
    <div class="section-heading">
      <div>
        <p class="section-note">Follow another thread</p>
        <h2 id="connections-title">No agreement stands alone.</h2>
      </div>
      <p>
        Courts, legislation, and related histories help explain what a treaty has meant over time. A
        connection is an invitation to examine the evidence.
      </p>
    </div>
    {experience.related.length ? (
      <div class="related-grid">
        {experience.related.map((link) => (
          <article class="related-card">
            <p class="related-kind">
              {kindNames[link.type] ?? link.type}
              {link.context ? ' · context' : ''}
            </p>
            <h3>
              {link.path ? (
                <a href={href(link.path)}>
                  {link.label}
                  <span aria-hidden="true">↗</span>
                </a>
              ) : (
                link.label
              )}
            </h3>
            {link.suggested && <p class="related-note">Suggested connection</p>}
          </article>
        ))}
      </div>
    ) : (
      <p class="research-gap">
        No additional histories are linked here yet. That is a research gap, not a conclusion about
        the agreement.
      </p>
    )}
  </section>
  <section id="take-action" class="action-section" aria-labelledby="action-title">
    <div class="action-intro">
      <p class="section-note">Carry this understanding forward</p>
      <h2 id="action-title">
        The history is ongoing.
        <br />
        So is the work.
      </h2>
      <p>
        Start with the nations connected to this history, then the organizations supporting land
        rights and return. Support goes directly to them.
      </p>
      <a href={href('/where/')}>
        Find the work connected to your place <span aria-hidden="true">↗</span>
      </a>
    </div>
    <SupportBox {n} />
  </section>
  <section id="evidence" class="evidence-section" aria-labelledby="evidence-title">
    <div class="evidence-main">
      <p class="section-note">Keep the evidence close</p>
      <h2 id="evidence-title">Read, question, trace.</h2>
      <Sources id={n.id} />
      <RecordCorrections {n} />
      {notes.text && (
        <details class="research-notes">
          <summary>Research notes and unresolved questions</summary>
          <p>{notes.text}</p>
          {notes.flags.length > 0 && <p class="small">Flags: {notes.flags.join(', ')}</p>}
        </details>
      )}
      <a class="full-map" href={href(fullMap)}>
        Explore linked land records on the full map <span aria-hidden="true">↗</span>
      </a>
      <p class="small muted">
        Historical geometry is approximate. Nothing here is a legal description of land, title, or
        jurisdiction.
      </p>
    </div>
    <aside aria-label="About this treaty record">
      <SpecimenLabel {n} />
    </aside>
  </section>
</article>
<style>
  .treaty-record {
    padding-top: 32px;
  }
  .back-link {
    display: inline-flex;
    gap: 12px;
    font-size: 0.8rem;
    text-decoration: none;
  }
  .treaty-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 8%;
    align-items: center;
    padding: 48px 0;
  }
  .treaty-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 24px;
    font-size: 0.8rem;
    color: var(--ink-2);
    margin-bottom: 24px;
  }
  .ratification {
    background: var(--sage);
    border-radius: 30px;
    padding: 5px 12px;
    color: var(--moss-deep);
  }
  .ratification.unratified {
    background: var(--clay);
    color: #774e35;
  }
  h1 {
    font-size: clamp(2.5rem, 4.5vw, 4.4rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin-bottom: 24px;
    max-width: 30ch;
  }
  .hero-description {
    max-width: 62ch;
    font-size: 1.1rem;
    color: var(--ink-2);
    line-height: 1.65;
    margin: 0;
  }
  .hero-aside {
    padding-left: 32px;
    border-left: 1px solid var(--rule);
  }
  .hero-aside :global(.record-mark) {
    display: block;
    width: 100px;
    height: 100px;
    color: #899575;
    margin-bottom: 24px;
  }
  .hero-aside p {
    font-size: 1.2rem;
    line-height: 1.35;
    letter-spacing: -0.02em;
  }
  .hero-aside > a {
    font-size: 0.8rem;
  }
  .unratified-note {
    padding: 18px 24px;
    background: var(--ochre);
    border-radius: 10px;
    font-size: 0.9rem;
    max-width: none;
  }
  .record-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
    padding: 20px 0;
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .record-nav a {
    min-height: 28px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.85rem;
    text-decoration: none;
  }
  .record-nav a:hover {
    text-decoration: underline;
  }
  .record-nav span {
    font-size: 0.7rem;
    background: var(--sheet-2);
    padding: 1px 7px;
    border-radius: 30px;
    color: var(--ink-2);
  }
  section[id] {
    scroll-margin-top: 24px;
  }
  .promise-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 8%;
    padding: 64px 0;
  }
  .section-note {
    font-size: 0.8rem;
    color: var(--moss);
    margin-bottom: 16px;
  }
  h2 {
    font-size: clamp(2rem, 3.5vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin: 0 0 24px;
  }
  .reading-column {
    min-width: 0;
  }
  .reading-column :global(.narrative) {
    margin-top: 28px;
  }
  .reading-column :global(.narrative > h2) {
    font-size: 1.3rem;
    margin-top: 0;
  }
  .reading-column :global(.headline) {
    font-size: 1.15rem;
  }
  .reading-column :global(.promises li) {
    grid-template-columns: 1fr;
    gap: 10px;
    padding: 22px;
    background: var(--sheet);
    border: 1px solid var(--rule);
    border-radius: 12px;
    margin-top: 12px;
  }
  .reading-column :global(.mark) {
    font-weight: 400;
    border: 0;
    padding: 4px 10px;
    width: fit-content;
    border-radius: 20px;
    background: var(--sheet-2);
  }
  .reading-column :global(.broken .mark) {
    background: var(--clay);
    color: #774e35;
  }
  .reading-column :global(.kept .mark) {
    background: var(--sage);
    color: var(--moss-deep);
  }
  .reading-column :global(.partly .mark) {
    background: var(--ochre);
    color: #6c572b;
  }
  .people-aside {
    background: var(--sheet-2);
    border-radius: 16px;
    padding: 28px;
    align-self: start;
  }
  .people-aside h3 {
    font-size: 1.6rem;
    font-weight: 400;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
  }
  .nation-links {
    list-style: none;
    padding: 0;
  }
  .nation-links li {
    border-top: 1px solid var(--rule-strong);
    padding: 16px 0;
  }
  .nation-links a {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    text-decoration: none;
    font-size: 1rem;
  }
  .nation-links small {
    display: block;
    font-size: 0.7rem;
    color: var(--ink-2);
    margin-top: 7px;
  }
  .parties-record,
  .research-notes {
    font-size: 0.85rem;
    padding: 18px 0;
    border-top: 1px solid var(--rule);
  }
  summary {
    color: var(--moss);
    cursor: pointer;
    min-height: 28px;
  }
  details > p {
    margin-top: 14px;
  }
  .research-gap {
    background: var(--sheet-2);
    border-radius: 12px;
    padding: 24px;
    margin: 28px 0;
  }
  .research-gap h3 {
    font-size: 1.2rem;
    margin: 0 0 16px;
  }
  .research-gap p {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .section-heading {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 10%;
    align-items: end;
    margin-bottom: 36px;
  }
  .section-heading h2 {
    margin: 0;
  }
  .section-heading > p {
    color: var(--ink-2);
    font-size: 0.95rem;
    margin: 0;
  }
  .history-section,
  .connections-section {
    padding: 64px 0;
    border-top: 1px solid var(--rule);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }
  .related-card {
    position: relative;
    padding: 24px;
    border-radius: 12px;
    border: 1px solid var(--rule);
    background: var(--sheet);
    min-width: 0;
  }
  .related-card:focus-within {
    outline: 2px solid var(--moss);
    outline-offset: 3px;
  }
  .related-kind {
    font-size: 0.75rem;
    color: var(--moss);
    margin-bottom: 20px;
  }
  .related-card h3 {
    font-size: 1.15rem;
    line-height: 1.3;
    font-weight: 400;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    padding-right: 16px;
  }
  .related-card h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  .related-card h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 12px;
  }
  .related-card h3 span {
    position: absolute;
    right: 20px;
    top: 56px;
    color: var(--moss);
  }
  .related-note {
    font-size: 0.7rem;
    color: var(--ink-2);
    margin: 0;
  }
  .action-section {
    display: grid;
    grid-template-columns: 0.8fr 1.2fr;
    gap: 8%;
    padding: 48px;
    background: var(--clay);
    border-radius: 20px;
    align-items: start;
  }
  .action-intro {
    position: sticky;
    top: 24px;
  }
  .action-intro > p:not(.section-note) {
    font-size: 0.95rem;
    color: var(--ink-2);
  }
  .action-intro > a {
    font-size: 0.85rem;
  }
  .action-section :global(.support) {
    margin-top: 0;
  }
  .evidence-section {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 8%;
    padding: 72px 0 0;
  }
  .evidence-main {
    min-width: 0;
  }
  .evidence-main :global(h2:not(#evidence-title)) {
    font-size: 1.3rem;
    margin-top: 32px;
  }
  .evidence-main :global(.sources) {
    font-size: 0.9rem;
  }
  .full-map {
    display: inline-flex;
    gap: 16px;
    font-size: 0.85rem;
    margin: 24px 0;
  }
  @media (max-width: 1000px) {
    .treaty-hero {
      grid-template-columns: 1fr 190px;
      gap: 32px;
    }
    .promise-section,
    .evidence-section {
      grid-template-columns: minmax(0, 1fr) 250px;
      gap: 32px;
    }
    .related-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .action-section {
      padding: 28px;
      gap: 28px;
    }
  }
  @media (max-width: 760px) {
    .treaty-hero {
      grid-template-columns: 1fr;
      padding: 32px 0;
    }
    .hero-aside {
      display: none;
    }
    .record-nav {
      gap: 12px 24px;
    }
    .promise-section,
    .evidence-section {
      grid-template-columns: 1fr;
      gap: 32px;
      padding-top: 40px;
    }
    .promise-section {
      padding-bottom: 40px;
    }
    .section-heading {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    .history-section,
    .connections-section {
      padding: 40px 0;
    }
    .action-section {
      grid-template-columns: 1fr;
      padding: 24px;
    }
    .action-intro {
      position: static;
    }
  }
  @media (max-width: 500px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
    .action-section {
      padding: 20px;
    }
  }
</style>
