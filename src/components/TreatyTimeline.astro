---
// What happened to a treaty's land, in order: every dated step in the 1899 federal record for the
// land this treaty touched (recognized, set aside, ceded, taken back), the treaty itself, and what
// came later in court, in law and in land returns. As each step scrolls past, the map beside it
// lights the land that step concerns. Works as a plain list without JavaScript.
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import type { Node } from '../lib/graph';
import { href } from '../lib/href';
import { frameAround, locatorMap } from '../lib/svgmap';
import { acresText, areaNumber, type Area, type LandStep } from '../lib/land';
import type { TreatyEvent } from '../lib/treaty';

interface Props {
  n: Node;
  areas: Area[];
  steps: LandStep[];
  events: TreatyEvent[];
}
const { n, areas, steps, events } = Astro.props;
const headlines = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'tables', 'headlines.json'), 'utf8'),
) as Record<string, string>;

const peoplesOf = (ids: string[]) => {
  const all = [...new Set(areas.filter((a) => ids.includes(a.id)).flatMap((a) => a.peoples))];
  return all.length > 2 ? `${all[0]}, ${all[1]} and others` : all.join(' and ');
};
const sentence = (s: LandStep) => {
  const who = peoplesOf(s.areas);
  const land = s.acres ? acresText(s.acres).replace(/^about/, 'About') : 'Land';
  switch (s.role) {
    case 'described_or_recognized':
      return `${land} recognized as ${who ? `land of the ${who}` : 'Native land'}`;
    case 'reserved':
      return `${land} set aside as a reservation${who ? ` for the ${who}` : ''}`;
    case 'confirmed':
      return `Earlier terms confirmed for ${who ? `the land of the ${who}` : 'this land'}`;
    case 'ceded':
      return `${land} recorded as ceded to the United States${who ? ` by the ${who}` : ''}`;
    case 'ceded_part':
      return `Part of the land recorded as ceded${who ? ` by the ${who}` : ''}`;
    case 'retroceded':
      return `${land} of reservation taken back by the United States`;
    case 'us_reserved':
      return `${land} kept by the United States for itself`;
    default:
      return `${land} named in the record`;
  }
};

type Row = {
  key: string;
  year: number | null;
  date: string;
  kind: 'kept' | 'lost' | 'other' | 'treaty' | 'broken' | 'court' | 'law' | 'return' | 'context';
  tag: string;
  title: string;
  text: string | null;
  href: string | null;
  areas: string[];
  anchor?: boolean;
};
const signed = String(n['date_signed'] ?? '');
const rows: Row[] = steps
  // the treaty's own row says what it did; its land steps are folded into it
  .filter((s) => !s.thisTreaty)
  .map((s) => ({
    key: `${s.date}-${s.role}-${s.areas.join()}`,
    year: s.year,
    date: s.date,
    kind: s.kind,
    tag: s.kind === 'lost' ? 'Land lost' : s.kind === 'kept' ? 'Land kept' : 'Land record',
    title: sentence(s),
    text: s.by
      ? `By ${s.by.label}`
      : s.quote
        ? `The 1899 record: “${s.quote.replace(/[.;,]$/, '')}”`
        : null,
    href: s.by?.href ? href(s.by.href) : null,
    areas: s.areas,
  }));
const mine = steps.filter((s) => s.thisTreaty);
rows.push({
  key: 'signed',
  year: signed ? Number(signed.slice(0, 4)) : null,
  date: signed || 'Date not recorded',
  kind: 'treaty',
  tag: 'This treaty',
  title: mine.length
    ? mine.map((s) => sentence(s)).join('. ')
    : n['ratification_status'] === 'unratified'
      ? 'Signed, but never ratified by the Senate'
      : 'Signed',
  text: headlines[n.id] ?? null,
  href: null,
  areas: [...new Set(mine.flatMap((s) => s.areas))].length
    ? [...new Set(mine.flatMap((s) => s.areas))]
    : areas.map((a) => a.id),
  anchor: true,
});
if (n['date_ratified'])
  rows.push({
    key: 'ratified',
    year: Number(String(n['date_ratified']).slice(0, 4)),
    date: String(n['date_ratified']),
    kind: 'treaty',
    tag: 'This treaty',
    title: 'Ratified by the Senate',
    text: null,
    href: null,
    areas: [],
  });
const KIND: Record<string, [Row['kind'], string]> = {
  Violation: ['broken', 'Promise broken'],
  Case: ['court', 'In court'],
  Statute: ['law', 'Law'],
  Campaign: ['return', 'Land returned'],
  Instrument: ['other', 'Related agreement'],
};
for (const e of events) {
  if (e.id === 'signed' || e.id === 'ratified' || e.type === 'GeoFeature' || !KIND[e.type])
    continue;
  const [kind, tag] = e.context ? (['context', 'Related history'] as const) : KIND[e.type]!;
  rows.push({
    key: e.id,
    year: e.year,
    date: e.date,
    kind,
    tag,
    title: e.label,
    text: headlines[e.id] ?? null,
    href: e.path ? href(e.path) : null,
    areas: e.geometryIds.filter((id) => areas.some((a) => a.id === id)),
  });
}
rows.sort((a, b) => (a.year ?? 9999) - (b.year ?? 9999) || a.date.localeCompare(b.date));

const m = locatorMap(areas.map((a) => a.id));
const fit = frameAround(
  m.hi.map((h) => h.d),
  [],
  70,
);
const view = fit ? `${fit.x} ${fit.y} ${fit.w} ${fit.h}` : `0 0 ${m.width} ${m.height}`;
const stroke = fit ? Math.max(0.6, fit.w / 500) : 1;
const showYear = (r: Row) => (r.year ? String(r.year) : '');
---

{rows.length > 1 && (
  <div class:list={['tl', { 'has-map': m.hi.length > 0 }]}>
    {m.hi.length > 0 && (
      <div class="tl-map" aria-hidden="true">
        <figure>
          <svg viewBox={view} style={`--sw: ${stroke}px`} preserveAspectRatio="xMidYMid meet">
            <image href={href('/map/base.svg')} width={m.width} height={m.height} />
            {m.hi.map((h) => (
              <path data-area={h.id} d={h.d} />
            ))}
          </svg>
          <figcaption>
            <span class="tl-now" data-now>
              The land in this treaty’s record
            </span>
            <span class="tl-key">
              <i class="k-kept" />
              stays with the nation
              <i class="k-lost" />
              leaves it
            </span>
          </figcaption>
        </figure>
      </div>
    )}
    <ol class="tl-rows">
      {rows.map((r) => (
        <li
          class:list={['tl-row', r.kind, { anchor: r.anchor }]}
          data-areas={r.areas.join(' ')}
          data-kind={r.kind}
          data-label={`${showYear(r)} ${r.tag.toLowerCase()}`}
          data-key={r.key}
          id={`event-${r.key}`}
          tabindex="-1"
        >
          <span class="tl-year">{showYear(r) || 'Date unknown'}</span>
          <div class="tl-body">
            <p class="tl-tag">{r.tag}</p>
            <h3>{r.href ? <a href={r.href}>{r.title}</a> : r.title}</h3>
            {r.text && <p class="tl-text">{r.text}</p>}
            {r.areas.length > 0 && r.kind !== 'treaty' && (
              <p class="tl-areas">
                {r.areas.slice(0, 6).map((id, i) => (
                  <>
                    {i > 0 && ' '}
                    <a href={href(`/cessions/${areaNumber(id)}/`)}>area {areaNumber(id)}</a>
                  </>
                ))}
              </p>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
)}

<script>
  // Light the land of whichever step is in the middle of the screen.
  for (const tl of document.querySelectorAll<HTMLElement>('.tl.has-map')) {
    const paths = [...tl.querySelectorAll<SVGPathElement>('path[data-area]')];
    const now = tl.querySelector<HTMLElement>('[data-now]');
    const rows = [...tl.querySelectorAll<HTMLElement>('.tl-row')];
    const show = (row: HTMLElement) => {
      const ids = new Set((row.dataset['areas'] ?? '').split(' ').filter(Boolean));
      const kind = row.dataset['kind'] ?? '';
      rows.forEach((r) => r.classList.toggle('on', r === row));
      for (const p of paths) {
        const on = ids.has(p.dataset['area'] ?? '');
        p.classList.toggle('on', on);
        p.classList.toggle('kept', on && kind === 'kept');
        p.classList.toggle('lost', on && (kind === 'lost' || kind === 'treaty'));
      }
      if (now) now.textContent = row.dataset['label'] ?? '';
    };
    const io = new IntersectionObserver(
      (es) => es.forEach((e) => e.isIntersecting && show(e.target as HTMLElement)),
      { rootMargin: '-45% 0px -50% 0px' },
    );
    rows.forEach((r) => {
      io.observe(r);
      r.addEventListener('mouseenter', () => show(r));
      r.addEventListener('focusin', () => show(r));
    });
    tl.classList.add('live');
    // older links name a step as #event=<record id>
    const want = new URLSearchParams(location.hash.slice(1)).get('event');
    const row = want ? rows.find((r) => r.dataset['key'] === want) : null;
    if (row) {
      show(row);
      row.scrollIntoView({ block: 'center' });
      row.focus({ preventScroll: true });
    }
  }
</script>

<style>
  .tl {
    display: grid;
    gap: var(--space-5);
  }
  @media (min-width: 900px) {
    .tl.has-map {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: var(--space-7);
      align-items: start;
    }
  }
  .tl-map {
    position: sticky;
    top: 0;
    z-index: 1;
    padding: var(--space-2) 0;
    background: var(--ground);
  }
  @media (min-width: 900px) {
    .tl-map {
      top: 24px;
      padding: 0;
    }
  }
  .tl-map figure {
    margin: 0;
    background: var(--sage);
    border-radius: 14px;
    overflow: hidden;
  }
  .tl-map svg {
    display: block;
    width: 100%;
    aspect-ratio: 27 / 20;
    height: auto;
    max-height: 34vh;
  }
  @media (min-width: 900px) {
    .tl-map svg {
      max-height: none;
    }
  }
  .tl-map path {
    fill: #a3af8d;
    fill-opacity: 0.55;
    stroke: #4d603c;
    stroke-width: var(--sw);
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    transition:
      fill 300ms var(--ease),
      fill-opacity 300ms var(--ease);
  }
  .live .tl-map path {
    fill-opacity: 0.25;
  }
  .live .tl-map path.on {
    fill-opacity: 0.9;
  }
  .live .tl-map path.kept {
    fill: #6f8a5a;
    stroke: var(--moss-deep);
  }
  .live .tl-map path.lost {
    fill: #9d6b4b;
    stroke: #5e3f28;
  }
  @media (prefers-reduced-motion: reduce) {
    .tl-map path {
      transition: none;
    }
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
    padding: var(--space-2) var(--space-4) var(--space-3);
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--ink-2);
  }
  .tl-now {
    font-weight: 600;
    color: var(--ink);
    text-transform: none;
  }
  .tl-key i {
    display: inline-block;
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 2px;
    margin: 0 4px 0 10px;
    vertical-align: -0.05rem;
  }
  .k-kept {
    background: #6f8a5a;
  }
  .k-lost {
    background: #9d6b4b;
  }
  .tl-rows {
    min-width: 0;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .tl-row {
    display: grid;
    grid-template-columns: 4.2rem minmax(0, 1fr);
    gap: var(--space-4);
    padding: var(--space-4) 0 var(--space-4) var(--space-4);
    border-left: 3px solid var(--rule);
    max-width: none;
    transition: border-color 300ms var(--ease);
  }
  .tl-row.kept {
    border-left-color: #a9bb98;
  }
  .tl-row.lost,
  .tl-row.broken {
    border-left-color: #c9a48c;
  }
  .tl-row.on.kept {
    border-left-color: #6f8a5a;
  }
  .tl-row.on.lost,
  .tl-row.on.broken {
    border-left-color: #9d6b4b;
  }
  .tl-row.return {
    border-left-color: var(--data-return);
  }
  .tl-row.court,
  .tl-row.law {
    border-left-color: var(--river);
  }
  .tl-row:focus {
    outline: none;
  }
  .tl-row.on {
    background: color-mix(in srgb, var(--sheet) 70%, transparent);
  }
  .tl-row.anchor {
    background: var(--sheet);
    border-left-color: var(--ink);
    border-radius: 0 12px 12px 0;
    padding-top: var(--space-5);
    padding-bottom: var(--space-5);
    margin: var(--space-2) 0;
  }
  .tl-year {
    font-family: var(--sans);
    font-size: var(--s1);
    font-variant-numeric: lining-nums tabular-nums;
    color: var(--ink);
    line-height: 1.3;
  }
  .tl-body {
    min-width: 0;
    overflow-wrap: break-word;
  }
  .tl-tag {
    font-family: var(--sans);
    font-size: var(--s-2);
    color: var(--ink-2);
    margin: 0 0 2px;
  }
  .tl-row h3 {
    font-size: var(--s0);
    font-weight: 600;
    line-height: 1.35;
    margin: 0;
  }
  .tl-row.anchor h3 {
    font-size: var(--s1);
  }
  .tl-row h3 a {
    color: var(--ink);
  }
  .tl-text {
    margin: var(--space-1) 0 0;
    font-size: var(--s-1);
    color: var(--ink-2);
    line-height: 1.5;
  }
  .tl-areas {
    margin: var(--space-1) 0 0;
    font-family: var(--sans);
    font-size: var(--s-2);
  }
  .tl-areas a {
    color: var(--ink-2);
    margin-right: var(--space-2);
  }
  @media (max-width: 480px) {
    .tl-row {
      grid-template-columns: 1fr;
      gap: 2px;
    }
  }
</style>
