---
import '@fontsource/atkinson-hyperlegible-next/400.css';
import '@fontsource/atkinson-hyperlegible-next/600.css';
import '@fontsource/noto-sans-cherokee/400.css';
import '@fontsource/noto-sans-osage/400.css';
import '../styles/global.css';
import BrandMark from '../components/BrandMark.astro';
import { href } from '../lib/href';
import { graph, pathFor, type Node } from '../lib/graph';
const supportGraph = graph();
const recordsByPath = ((globalThis as { __recordsByPath?: Map<string, Node> }).__recordsByPath ??=
  new Map(
    [...supportGraph.nodes.values()].flatMap((n) => {
      const path = pathFor(n);
      return path ? [[href(path), n] as [string, Node]] : [];
    }),
  ));
const currentRecord = recordsByPath.get(Astro.url.pathname);
// on a record page the header button goes to that page's own "Who is doing the work" section
const supportHref =
  currentRecord && currentRecord.type !== 'Organization' ? '#support' : href('/organizations/');

interface Props {
  title: string;
  description?: string;
  /** Full-bleed pages (the map) skip the frame and footer spacing. */
  bleed?: boolean;
  noindex?: boolean;
}
const {
  title,
  description = 'What the United States promised Native nations, what happened, what courts said, and what is being returned.',
  bleed = false,
  noindex = false,
} = Astro.props;
const stage = process.env.SITE_STAGE ?? 'preview';
const pageTitle = title === 'Living Law, Living Land' ? title : `${title}, Living Law, Living Land`;
const nav = [
  ['/where/', 'Where you live'],
  ['/map/', 'Map'],
  ['/nations/', 'Nations'],
  ['/treaties/', 'Treaties'],
  ['/returns/', 'Land returns'],
  ['/search/', 'Search'],
];
const here = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {(stage !== 'production' || noindex) && <meta name="robots" content="noindex, nofollow" />}
    <link rel="stylesheet" href={href('/fonts/charis.css')} />
    <link
      rel="preload"
      href={href('/fonts/charis-regular-core.woff2')}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href={href('/favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#f5f1e8" media="(prefers-color-scheme: dark)" />
    <slot name="head" />
  </head>
  <body class={bleed ? 'bleed' : ''}>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="frame bar">
        <a class="wordmark" href={href('/')}>
          <BrandMark class="brand-icon" />
          <span class="brand-name">
            Living Law,
            <br />
            Living Land
          </span>
        </a>
        <nav aria-label="Main">
          <ul>
            {nav.map(([path, label]) => (
              <li>
                <a
                  href={href(path!)}
                  aria-current={here.startsWith(href(path!)) ? 'page' : undefined}
                >
                  {label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <a class="header-support" href={supportHref} data-fallback={href('/organizations/')}>
          Support land rights <span aria-hidden="true">↗</span>
        </a>
      </div>
    </header>
    <main id="main" class={bleed ? '' : 'frame'}>
      <slot />
    </main>
    {!bleed && (
      <footer class="site-footer">
        <div class="frame">
          <div class="footer-intro">
            <p class="footer-title">
              The record matters.
              <br />
              What happens next does, too.
            </p>
            <a href={href('/where/')}>
              Start with where you live <span aria-hidden="true">↗</span>
            </a>
          </div>
          <p class="stage-note sans">
            Early release. Nothing here has been reviewed by a Native nation or a lawyer yet. Every
            record shows its sources and how sure we are.{' '}
            <a href={href('/about/')}>What that means</a>
          </p>
          <p>
            Created by Benjamin Life (@omniharmonic). Text and data CC BY 4.0, code MIT.{' '}
            <a href={href('/methods/sources/')}>Sources and credits</a>.
          </p>
          <ul class="footer-links sans">
            <li>
              <a href={href('/law/')}>Treaty law</a>
            </li>
            <li>
              <a href={href('/story/')}>The story</a>
            </li>
            <li>
              <a href={href('/organizations/')}>Organizations</a>
            </li>
            <li>
              <a href={href('/claim/')}>For Native nations: claim or correct a page</a>
            </li>
            <li>
              <a href={href('/corrections/')}>Report an error</a>
            </li>
            <li>
              <a href={href('/methods/')}>Methods</a>
            </li>
            <li>
              <a href={href('/about/')}>About</a>
            </li>
            <li>
              <a href={href('/privacy/')}>Privacy</a>
            </li>
            <li>
              <a href={href('/accessibility/')}>Accessibility</a>
            </li>
          </ul>
          <p class="small muted">
            Not legal advice. Nothing here is a legal description of land, title or jurisdiction.
          </p>
        </div>
      </footer>
    )}
  </body>
</html>

<script>
  // a record page without its own support section sends the button to the directory instead
  const support = document.querySelector<HTMLAnchorElement>('a.header-support[href="#support"]');
  if (support && !document.getElementById('support')) support.href = support.dataset.fallback!;
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--rule);
  }
  .site-header {
    background: var(--sheet);
  }
  .bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-2) var(--space-6);
    padding-top: 16px;
    padding-bottom: 16px;
  }
  /* the nav sits beside the wordmark; the support button holds the far edge */
  .bar nav {
    margin-right: auto;
  }
  .wordmark {
    font-family: var(--sans);
    font-size: 1rem;
    color: var(--ink);
    text-decoration: none;
    letter-spacing: -0.035em;
    display: flex;
    align-items: center;
    gap: 12px;
    white-space: nowrap;
    font-weight: 600;
  }
  nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0 18px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  nav a {
    font-family: var(--sans);
    font-size: var(--s-1);
    color: var(--ink-2);
    text-decoration: none;
    display: inline-block;
    padding: var(--space-2) 0;
    min-height: 24px;
  }
  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--moss);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.35em;
  }
  .stage-note {
    font-size: var(--s-2);
    color: var(--ink-2);
    margin-top: var(--space-2);
    margin-bottom: 0;
    max-width: none;
  }
  .brand-name {
    line-height: 1.05;
    letter-spacing: -0.025em;
  }
  .wordmark :global(.brand-icon) {
    width: 32px;
    height: 32px;
    color: var(--moss);
  }
  .header-support {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    background: var(--moss);
    color: var(--on-moss);
    text-decoration: none;
    border-radius: 7px;
    font-size: 0.85rem;
  }
  .header-support:hover {
    background: var(--moss-deep);
  }
  .footer-intro {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 32px;
    margin-bottom: 56px;
  }
  .footer-title {
    font-size: clamp(1.7rem, 4vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1.15;
    color: var(--ink);
    margin: 0;
  }
  .site-footer {
    margin-top: var(--space-8);
    padding: var(--space-6) 0 var(--space-7);
    border-top: 1px solid var(--rule);
    font-size: var(--s-1);
    color: var(--ink-2);
  }
  .footer-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  @media (max-width: 1100px) {
    .bar {
      gap: 12px 24px;
    }
    nav {
      order: 3;
      width: 100%;
    }
    nav ul {
      justify-content: space-between;
    }
  }
  @media (max-width: 600px) {
    .header-support {
      font-size: 0.75rem;
      padding: 8px 10px;
      gap: 8px;
    }
    .wordmark {
      font-size: 0.95rem;
      gap: 8px;
    }
    .wordmark :global(.brand-icon) {
      width: 24px;
    }
    /* one row that scrolls sideways, edge to edge, instead of wrapping onto a second line */
    nav {
      margin: 0 calc(var(--gutter, 16px) * -1);
      -webkit-mask-image: linear-gradient(to right, #000 85%, transparent);
      mask-image: linear-gradient(to right, #000 85%, transparent);
    }
    nav ul {
      flex-wrap: nowrap;
      gap: 0 18px;
      justify-content: flex-start;
      overflow-x: auto;
      scrollbar-width: none;
      padding: 0 calc(var(--gutter, 16px) + 24px) 0 var(--gutter, 16px);
    }
    nav ul::-webkit-scrollbar {
      display: none;
    }
    nav li {
      flex: none;
    }
    nav a {
      font-size: 0.85rem;
      padding: 10px 0;
    }
    .bar {
      padding-top: 12px;
      padding-bottom: 4px;
      row-gap: 4px;
    }
    .footer-intro {
      align-items: flex-start;
      flex-direction: column;
    }
    .site-footer {
      padding-bottom: 40px;
    }
  }
  .bleed .stage-note {
    margin: var(--space-1) 0;
  }
</style>
