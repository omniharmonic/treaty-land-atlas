---
import Base from './Base.astro';
interface Props {
  title: string;
  description?: string;
  lede?: string;
}
const { title, description, lede } = Astro.props;
---

<Base title={title} description={description ?? lede}>
  <article class="page">
    <h1>{title}</h1>
    {lede && <p class="lede">{lede}</p>}
    <slot />
  </article>
</Base>

<style>
  .page {
    padding: var(--space-6) 0 var(--space-7);
    max-width: 44rem;
  }
  .page :global(h2) {
    font-size: var(--s2);
  }
</style>
