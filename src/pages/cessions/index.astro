---
import Base from '../../layouts/Base.astro';
import IndexList from '../../components/IndexList.astro';
import { byType } from '../../lib/graph';
import { href } from '../../lib/href';

const all = byType('GeoFeature').sort(
  (a, b) => Number(a['t_first'] ?? 0) - Number(b['t_first'] ?? 0),
);
---

<Base
  title="Land areas"
  description="The 724 areas of Native land the United States recorded as ceded or reserved between 1784 and 1894."
>
  <div class="intro">
    <h1>Land areas</h1>
    <p class="lede">
      In 1899 the Smithsonian’s Bureau of American Ethnology published Charles C. Royce’s record of
      the land the United States acquired from Native nations, and the reservations it set aside, by
      treaty, act of Congress and executive order from 1784 to 1894. He drew {all.length} numbered
      areas on maps and listed what each agreement did to each one. Those numbers are how this atlas
      names the land.
    </p>
    <p>
      The shapes come from the US Forest Service’s tracing of his maps. They are approximate, not
      legal descriptions, and they show what the government recorded, not the extent of any nation’s
      homeland. <a href={href('/map/')}>See them on the map</a>.
    </p>
  </div>
  <IndexList
    items={all}
    dated
    note={(n) => ((n['tribes_as_named_in_schedule'] as string[]) ?? []).join(', ') || null}
  />
</Base>

<style>
  .intro {
    padding-top: var(--space-6);
  }
</style>
