---
// Built from docs/research/D4-glossary.md: one entry per **Term.** paragraph, grouped as in the file.
import Page from '../layouts/Page.astro';
import { readFileSync } from 'node:fs';
import { cleanTags } from '../lib/graph';

const text = readFileSync('docs/research/D4-glossary.md', 'utf8');
const groups: {
  title: string;
  terms: { term: string; slug: string; body: string; flags: string[] }[];
}[] = [];
for (const block of text.split(/^## /m).slice(1)) {
  const [head, ...rest] = block.split('\n');
  if (!head || !/^Group \d/.test(head)) continue;
  const title = head.replace(/^Group \d+\.\s*/, '').trim();
  const terms = rest
    .join('\n')
    .split(/\n\s*\n/)
    .map((p) => /^\*\*(.+?)\*\*\s*([\s\S]*)$/.exec(p.trim()))
    .filter((m): m is RegExpExecArray => !!m)
    .map((m) => {
      const term = m[1]!.replace(/\.$/, '');
      const body = m[2]!
        .replace(/\[(verified-secondary|site term)\]/g, '')
        .replace(/`/g, '')
        .replace(/\*([^*]+)\*/g, '$1')
        .replace(/\s+/g, ' ')
        .trim();
      const tagged = cleanTags(body);
      return {
        term,
        slug: term
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, '-')
          .replace(/^-|-$/g, ''),
        body: tagged.text,
        flags: tagged.flags,
      };
    });
  groups.push({ title, terms });
}
---

<Page
  title="Glossary"
  lede="Legal and land words used in this atlas. Several sound alike and mean different things in law."
>
  <nav class="sans small" aria-label="Glossary groups">
    {groups.map((g) => (
      <a href={`#${g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`}>{g.title}</a>
    ))}
  </nav>
  {groups.map((g) => (
    <section>
      <h2 id={g.title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}>{g.title}</h2>
      <dl>
        {g.terms.map((t) => (
          <>
            <dt id={t.slug}>{t.term}</dt>
            <dd>
              {t.body}
              {t.flags.includes('from-memory') && (
                <span class="flag sans"> some details not yet checked against a source</span>
              )}
            </dd>
          </>
        ))}
      </dl>
    </section>
  ))}
</Page>

<style>
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
  }
  dt {
    font-weight: 700;
    margin-top: var(--space-5);
  }
  dd {
    margin: var(--space-1) 0 0;
    max-width: var(--measure);
  }
  .flag {
    font-size: var(--s-2);
    color: var(--warn);
  }
</style>
