---
import Base from '../layouts/Base.astro';
import { byType, graph, pathFor, year } from '../lib/graph';
import { href } from '../lib/href';
import { homeMap } from '../lib/svgmap';
import { supportIndex } from '../lib/support';

const art = homeMap();
const SPAN = 8000; // ms for 1784 to 1894
const cessions = byType('GeoFeature').length;
const nations = byType('Nation').length;
const treaties = byType('Instrument').length;
const returns = byType('Campaign')
  .filter((n) => String(n['campaign_status']).startsWith('completed') && n.confidence !== 'low')
  .sort((a, b) => (year(b) ?? 0) - (year(a) ?? 0))
  .slice(0, 4);
const acres = (n: (typeof returns)[number]) =>
  n['acres'] ? `${Number(n['acres']).toLocaleString('en-US')} acres` : null;
const g = graph();
const ix = supportIndex([...g.nodes.values()], g.edges);
const national = ix.national.slice(0, 3).map((id) => ix.orgs[id]!);
---

<Base
  title="Treaty Land Atlas"
  description="Type an address and learn whose homelands you live on, how the United States took that land, the treaty promises broken, and who is working to restore it."
>
  <section class="hero" aria-labelledby="ask">
    <h1 id="ask">Whose land are you on?</h1>
    <figure class="land" id="land" aria-labelledby="land-cap">
      <div class="stage">
        <svg
          viewBox={`0 0 ${art.width} ${art.height}`}
          role="img"
          aria-label={`Map of the lower 48 states. Green land still held by Native nations drains year by year as ${cessions} cessions are recorded, 1784 to 1894; then today's reservations and trust lands appear.`}
        >
          {art.years.map(({ y, d }) => (
            <path
              class="yr"
              d={d}
              style={`--d: ${Math.round(((Math.min(y, 1895) - 1784) / (1894 - 1784)) * SPAN)}ms`}
            />
          ))}
          <path class="today" d={art.lands} />
        </svg>
        <p class="clock" aria-hidden="true">
          <span id="clock-year">1784</span>
        </p>
      </div>
      <figcaption id="land-cap" class="sans">
        <span class="key">
          <i class="k-held"></i>Held by Native nations, by the United States’ own record
        </span>
        <span class="key">
          <i class="k-ceded"></i>Recorded as ceded, 1784 to 1894 (Royce)
        </span>
        <span class="key">
          <i class="k-today"></i>Native lands today
        </span>
        <span class="note">
          Royce’s record begins in 1784; most of the East was taken earlier, by colonies and states.
        </span>
        <button type="button" class="replay" id="replay">
          Play it again
        </button>
      </figcaption>
    </figure>
    <div class="copy">
      <p class="lede">
        Every place in the United States has a treaty history. Find yours: whose homeland it is, how
        it was taken and when, which promises were broken, and who is working to restore land and
        law there now.
      </p>
      <form class="ask sans" id="ask-form" role="search" aria-label="Look up a place">
        <label for="home-q">Your address, town or ZIP code</label>
        <div class="row">
          <input
            id="home-q"
            name="q"
            type="text"
            autocomplete="street-address"
            required
            minlength="3"
          />
          <button type="submit">Look it up</button>
        </div>
        <p class="fine">
          Nothing is stored or tracked. <a href={href('/where/#loc')}>Use my location instead</a>
        </p>
      </form>
      <noscript>
        <p class="sans">
          The lookup needs JavaScript. <a href={href('/places/')}>Choose your state</a> instead.
        </p>
      </noscript>
    </div>
  </section>

  <section class="learn" aria-labelledby="learn">
    <h2 id="learn">Keep learning</h2>
    <dl>
      <div>
        <dt>
          <a href={href('/map/')}>Watch the land change hands</a>
        </dt>
        <dd>
          Play the years from 1784 to 1894, colored by how each piece was taken: treaty, pressure,
          removal, Congress or executive order. Follow one nation through its losses.
        </dd>
      </div>
      <div>
        <dt>
          <a href={href('/treaties/')}>Read what was promised</a>
        </dt>
        <dd>
          {treaties} treaties and agreements, each with a plain reading of its sources, the land it
          took, the promises broken and the cases fought over it.
        </dd>
      </div>
      <div>
        <dt>
          <a href={href('/nations/')}>Meet the nations</a>
        </dt>
        <dd>
          {nations} nations and peoples, in the treaty records and today, with their own names where
          a source gives them, including communities the federal list leaves out.
        </dd>
      </div>
    </dl>
  </section>

  <section class="support" aria-labelledby="support">
    <h2 id="support">Then, support the people doing the work</h2>
    <p>
      Your lookup shows the nations and groups tied to your place. These work across the country on
      treaty rights, Native law and land return:
    </p>
    <ul class="orgs">
      {national.map((o) => (
        <li>
          <a href={href(o.path ?? '/support/')}>{o.label}</a>
          <span class="sans meta">{o.focus.split(/[;.]/)[0]}</span>
          {o.donate && (
            <a class="give sans" href={o.donate} rel="noopener">
              Give on their site
            </a>
          )}
        </li>
      ))}
    </ul>
    <h3>Land is coming back</h3>
    <ul class="returns">
      {returns.map((r) => (
        <li>
          <a href={href(pathFor(r)!)}>{r.label}</a>
          <span class="sans meta">
            {year(r)}
            {acres(r) && `, ${acres(r)}`}
          </span>
        </li>
      ))}
    </ul>
    <p class="sans">
      <a href={href('/returns/')}>All documented land returns</a> ·{' '}
      <a href={href('/support/')}>Every listed organization, and how they are checked</a>
    </p>
  </section>

  <section class="claim-note" aria-labelledby="claim-h">
    <h2 id="claim-h">For Native nations</h2>
    <p>
      Nothing here speaks for your nation, and nothing has been reviewed by a nation yet. Every
      nation’s page can be claimed: corrected, told in your own words, or taken down. A removal
      request is honored first and discussed second.
    </p>
    <p class="sans">
      <a href={href('/claim/')}>Claim or correct a page</a>
    </p>
  </section>
</Base>

<script>
  // The land drains year by year (CSS, one path per year); this keeps the year in step and
  // replays on request. Reduced motion: the final state is shown and the clock reads "Today".
  const fig = document.getElementById('land');
  const clock = document.getElementById('clock-year');
  const SPAN = 8000;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  function play() {
    if (!fig || !clock) return;
    if (still) {
      clock.textContent = 'Today';
      return;
    }
    fig.classList.remove('play');
    void fig.getBoundingClientRect(); // restart the CSS animations
    fig.classList.add('play');
    const t0 = performance.now();
    const tick = (t: number) => {
      const k = (t - t0) / SPAN;
      clock.textContent = k >= 1 ? 'Today' : String(1784 + Math.floor(k * 110));
      if (k < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }
  play();
  document.getElementById('replay')?.addEventListener('click', play);

  // The address goes in the hash of /where/, which browsers never send to a server.
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
    if (q.length < 3) return;
    const base = import.meta.env.BASE_URL.replace(/\/$/, '');
    location.href = `${base}/where/#q=${encodeURIComponent(q)}`;
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-areas: 'q' 'land' 'copy';
    gap: var(--space-4);
    padding: var(--space-5) 0 var(--space-7);
  }
  .hero h1 {
    grid-area: q;
  }
  .land {
    grid-area: land;
  }
  .copy {
    grid-area: copy;
  }
  @media (min-width: 980px) {
    .hero {
      grid-template-areas: 'q land' 'copy land';
      grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.45fr);
      grid-template-rows: auto 1fr;
      align-items: start;
      gap: var(--space-4) var(--space-7);
      padding-top: var(--space-6);
    }
    .land {
      align-self: center;
    }
  }
  h1 {
    font-size: clamp(2.6rem, 7.4vw, 5.4rem);
    line-height: 0.98;
    letter-spacing: -0.015em;
    margin: 0 0 var(--space-4);
    max-width: 9ch;
  }
  .lede {
    max-width: 34rem;
  }
  .ask {
    margin-top: var(--space-5);
    max-width: 34rem;
  }
  .ask label {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  input {
    flex: 1 1 14rem;
    min-width: 0;
    min-height: 3.25rem;
    font: inherit;
    font-size: var(--s1);
    padding: var(--space-2) var(--space-3);
    border: 2px solid var(--ink);
    border-radius: var(--radius);
    background: var(--sheet);
    color: var(--ink);
  }
  button {
    min-height: 3.25rem;
    padding: 0 var(--space-5);
    font: inherit;
    font-weight: 600;
    background: var(--moss);
    color: var(--on-moss);
    border: 0;
    border-radius: var(--radius);
    cursor: pointer;
  }
  button:hover {
    background: var(--moss-deep);
  }
  .fine {
    font-size: var(--s-1);
    color: var(--ink-2);
    margin-top: var(--space-2);
  }
  .land {
    margin: 0;
  }
  .note {
    flex-basis: 100%;
    font-size: var(--s-2);
  }
  .land svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .yr {
    fill: var(--held);
    fill-opacity: 0;
    stroke: var(--ink-3);
    stroke-width: 0.5;
    stroke-opacity: 0.45;
    stroke-linejoin: round;
  }
  .today {
    fill: var(--moss-deep);
    stroke: var(--moss-deep);
    stroke-width: 0.6;
  }
  .play .yr {
    animation: cede 700ms ease-out var(--d) both;
  }
  .play .today {
    animation: rise 1800ms ease-out 8200ms both;
  }
  @keyframes cede {
    from {
      fill-opacity: 0.66;
      stroke: var(--held);
      stroke-opacity: 0.9;
    }
    to {
      fill-opacity: 0;
      stroke: var(--ink-3);
      stroke-opacity: 0.45;
    }
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: scale(0.985);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
  .stage {
    position: relative;
  }
  .clock {
    position: absolute;
    left: 1%;
    bottom: 2%;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.6rem);
    line-height: 1;
    color: var(--ink);
    font-variant-numeric: lining-nums tabular-nums;
    pointer-events: none;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    align-items: center;
    font-size: var(--s-1);
    color: var(--ink-2);
    margin-top: var(--space-3);
  }
  .key i {
    display: inline-block;
    width: 0.9rem;
    height: 0.9rem;
    margin-right: var(--space-2);
    vertical-align: -0.1rem;
    border-radius: 2px;
  }
  .k-held {
    background: color-mix(in srgb, var(--held) 66%, var(--ground));
  }
  .k-ceded {
    border: 1px solid var(--ink-3);
  }
  .k-today {
    background: var(--moss-deep);
  }
  .replay {
    background: none;
    border: 0;
    padding: var(--space-1) 0;
    min-height: var(--tap);
    font: inherit;
    color: var(--moss);
    text-decoration: underline;
    cursor: pointer;
  }
  .learn,
  .support {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--rule);
  }
  .learn dl {
    display: grid;
    gap: var(--space-5) var(--space-7);
    margin: 0;
  }
  @media (min-width: 760px) {
    .learn dl {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .learn dt {
    font-size: var(--s1);
    margin-bottom: var(--space-1);
  }
  .learn dd {
    margin: 0;
    color: var(--ink-2);
  }
  .support > p {
    max-width: 40rem;
  }
  .orgs,
  .returns {
    list-style: none;
    padding: 0;
    max-width: 40rem;
  }
  .orgs li,
  .returns li {
    padding: var(--space-3) 0;
    border-top: 1px solid var(--rule);
  }
  .orgs li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0 var(--space-4);
    align-items: baseline;
  }
  .orgs .meta {
    grid-column: 1;
  }
  .give {
    grid-column: 2;
    grid-row: 1 / span 2;
    font-weight: 600;
    color: var(--moss);
  }
  .meta {
    display: block;
    font-size: var(--s-1);
    color: var(--ink-3);
  }
  .claim-note {
    margin-top: var(--space-6);
    padding: var(--space-5) var(--space-5) var(--space-3);
    border-left: 3px solid var(--moss);
    background: var(--sheet);
  }
  .claim-note h2 {
    margin-top: 0;
  }
</style>
