---
import Base from '../layouts/Base.astro';
import OrganizationCard from '../components/OrganizationCard.astro';
import { byType, graph, pathFor, year } from '../lib/graph';
import { href } from '../lib/href';
import { homeMap } from '../lib/svgmap';
import { supportIndex } from '../lib/support';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
const art = homeMap();
// the story's chapters as one ribbon from 1784 to today, each as wide as the years it covers
const story = JSON.parse(
  readFileSync(join(process.cwd(), 'public', 'data', 'tables', 'story.json'), 'utf8'),
) as { chapters: { start_year: number; end_year: number; title: string }[] };
const chapters = [...story.chapters]
  .sort((a, b) => a.start_year - b.start_year)
  .map((c, i) => ({ n: i + 1, from: c.start_year, to: c.end_year, title: c.title }));
const span = (c: { from: number; to: number }) => c.to - c.from + 1;
const cases = byType('Case').length;
const statutes = byType('Statute').length;
const treaties = byType('Instrument').length;
const nations = byType('Nation').length;
const returns = byType('Campaign')
  .filter((n) => String(n['campaign_status']).startsWith('completed') && n.confidence !== 'low')
  .sort((a, b) => (year(b) ?? 0) - (year(a) ?? 0))
  .slice(0, 3);
const g = graph();
const ix = supportIndex([...g.nodes.values()], g.edges);
const national = ix.national.slice(0, 3).map((id) => ix.orgs[id]!);
---

<Base
  title="Living Law, Living Land"
  description="Find the treaty history of where you live, follow the record of land loss, and connect with organizations working for Indigenous land rights today."
>
  <section class="hero" aria-labelledby="ask">
    <div class="hero-copy">
      <p class="intro-line">
        <span aria-hidden="true"></span> The land holds a history. You’re part of its future.
      </p>
      <h1 id="ask">
        Every place
        <br />
        has a promise.
      </h1>
      <p class="hero-description">
        Discover whose homeland you live on, what was promised, and who is working to restore land
        and rights today.
      </p>
      <form id="ask-form" role="search" aria-label="Look up a place">
        <label for="home-q">Start with where you are</label>
        <div class="search-field">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="none">
            <circle cx="10" cy="10" r="6" stroke="currentColor" stroke-width="1.5" />
            <path d="m15 15 5 5" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <input
            id="home-q"
            name="q"
            type="text"
            placeholder="Address, town or ZIP code"
            aria-label="Your address, town or ZIP code"
            autocomplete="street-address"
            required
            minlength="3"
          />
          <button type="submit" aria-label="Look it up">
            <span aria-hidden="true">↗</span>
          </button>
        </div>
        <p class="privacy">
          <a href={href('/where/#loc')}>Use my location</a>
          <span>Your location is never stored.</span>
        </p>
      </form>
      <noscript>
        <p>
          <a href={href('/places/')}>Choose your state</a> to explore without JavaScript.
        </p>
      </noscript>
    </div>
    <div class="land-col">
      <figure class="land" id="land" aria-labelledby="land-cap">
        <div class="map-heading">
          <span>A record of changing borders</span>
        </div>
        <div class="stage">
          <svg
            viewBox={`0 0 ${art.width} ${art.height}`}
            role="img"
            aria-label="Recorded cessions in the lower 48, 1784–1894, and present-day Native lands. This is a historical record, not a map of all Indigenous homelands."
          >
            {art.years.map(({ y, d }) => (
              <path class="yr" d={d} data-year={y} />
            ))}
            <path class="today" d={art.lands} />
          </svg>
          <p class="map-year" id="clock-year">
            1784
          </p>
          <span class="map-context" id="map-context">
            The recorded cessions begin
          </span>
        </div>
        <div class="time-controls">
          <button type="button" id="replay" aria-label="Play land history">
            ▶
          </button>
          <div class="scrubber">
            <label class="visually-hidden" for="home-year">
              Year of recorded cessions
            </label>
            <input
              id="home-year"
              type="range"
              min="1784"
              max="1895"
              value="1784"
              aria-valuetext="1784"
            />
            <div class="time-labels">
              <span>1784</span>
              <span>1830</span>
              <span>1894</span>
              <span>Today</span>
            </div>
          </div>
        </div>
        <figcaption id="land-cap">
          <div class="keys">
            <span>
              <i class="k-held"></i>Before recorded cession
            </span>
            <span>
              <i class="k-today"></i>Native lands today
            </span>
          </div>
          <p>
            Royce’s record, 1784–1894. Much of the East was taken earlier. Boundaries are historical
            evidence, not the limits of belonging.{' '}
            <a href={href('/methods/sources/')}>About the sources</a>
          </p>
        </figcaption>
      </figure>
      <nav class="read-on" aria-label="Go deeper">
        <div class="read-actions">
          <a class="ra ra-map" href={href('/map/')}>
            Explore the map
          </a>
          <a class="ra ra-story" href={href('/story/')}>
            Read the story
          </a>
        </div>
        <ol class="ribbon" aria-label="The story in twelve chapters, 1784 to today">
          {chapters.map((c) => (
            <li style={`flex: ${span(c)} 1 0`}>
              <a
                href={href(`/story/#ch-${c.n}`)}
                data-from={c.from}
                data-to={c.to}
                data-label={`Chapter ${c.n}: ${c.title}, ${c.from}–${c.to === 2026 ? 'today' : c.to}`}
                aria-label={`Chapter ${c.n}: ${c.title}, ${c.from} to ${c.to === 2026 ? 'today' : c.to}`}
              >
                <span class="seg" />
              </a>
            </li>
          ))}
        </ol>
        <p class="ribbon-ends" aria-hidden="true">
          <span>1784</span>
          <span>today</span>
        </p>
        <p class="ribbon-now">
          <span id="ribbon-now">Chapter 1: {chapters[0]!.title}, 1784–1794</span>
        </p>
      </nav>
    </div>
  </section>
  <p class="release sans">
    Independent research, open to correction.{' '}
    <a href={href('/about/')}>Early release: not yet reviewed by Native nations or legal counsel</a>
  </p>
  <section class="pathways" aria-label="Explore the record">
    <a href={href('/law/')}>
      <span class="path-icon" aria-hidden="true">
        ⌁
      </span>
      <span>
        <strong>See what the courts did</strong>
        <small>
          {cases} court cases and {statutes} laws
        </small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
    <a href={href('/treaties/')}>
      <span class="path-icon" aria-hidden="true">
        ≋
      </span>
      <span>
        <strong>Read the promises</strong>
        <small>{treaties} treaties and agreements</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
    <a href={href('/nations/')}>
      <span class="path-icon" aria-hidden="true">
        ⊞
      </span>
      <span>
        <strong>Know the nations</strong>
        <small>{nations} nations and peoples in the record</small>
      </span>
      <span aria-hidden="true">↗</span>
    </a>
  </section>
  <section class="action-section" aria-labelledby="support">
    <div class="section-heading">
      <div>
        <p class="section-note">Living nations. Ongoing work.</p>
        <h2 id="support">
          Understanding is a start.
          <br />
          Connection is what comes next.
        </h2>
      </div>
      <p>
        Indigenous-led organizations are defending treaty rights, restoring land, and building
        futures. Meet the people moving this work forward.
      </p>
    </div>
    <div class="org-grid">
      {national.map((org) => (
        <OrganizationCard {org} />
      ))}
    </div>
    <div class="action-bottom">
      <p>Support goes directly to each organization. This atlas takes nothing.</p>
      <a href={href('/organizations/')}>
        Find your connection <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
  <section class="returns-section" aria-labelledby="return-h">
    <div class="return-intro">
      <p class="section-note">The story continues</p>
      <h2 id="return-h">
        Land is
        <br />
        coming back.
      </h2>
      <p>
        Return is happening through the work of nations, communities, and land trusts. Explore
        documented returns and the people behind them.
      </p>
      <a href={href('/returns/')}>
        Explore land returns <span aria-hidden="true">↗</span>
      </a>
    </div>
    <div class="return-list">
      {returns.map((r) => (
        <a href={href(pathFor(r)!)}>
          <span class="return-year">{year(r)}</span>
          <span class="return-name">
            {r.label}
            <small>
              {r['acres']
                ? `${Number(r['acres']).toLocaleString('en-US')} acres`
                : 'Documented land return'}
            </small>
          </span>
          <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
  </section>
  <section class="claim-note">
    <div>
      <h2>
        A record open to correction.
        <br />A history that belongs to you.
      </h2>
      <p>
        For Native nations: this atlas does not speak for you. No nation has reviewed it yet. Claim
        your nation’s page, tell it in your own words, correct it, or ask us to remove it. Removal
        requests are honored first.
      </p>
    </div>
    <a href={href('/claim/')}>
      Claim or correct a page <span aria-hidden="true">↗</span>
    </a>
  </section>
</Base>
<script>
  const fig = document.getElementById('land');
  const clock = document.getElementById('clock-year');
  const context = document.getElementById('map-context');
  const slider = document.getElementById('home-year') as HTMLInputElement | null;
  const playButton = document.getElementById('replay');
  const paths = Array.from(fig?.querySelectorAll<SVGPathElement>('.yr') ?? []);
  const segs = Array.from(document.querySelectorAll<HTMLAnchorElement>('.ribbon a'));
  const now = document.getElementById('ribbon-now');
  let pinned: HTMLAnchorElement | null = null;
  function light(a: HTMLAnchorElement | undefined) {
    if (!a) return;
    segs.forEach((s) => s.classList.toggle('on', s === a));
    if (now) now.textContent = a.dataset.label ?? '';
  }
  function showChapter(y: number) {
    if (pinned) return;
    light(segs.find((s) => Number(s.dataset.from) <= y && y <= Number(s.dataset.to)));
  }
  segs.forEach((a) => {
    const hold = () => {
      pinned = a;
      light(a);
    };
    const release = () => {
      pinned = null;
      showChapter(Number(slider?.value ?? 1784) === 1895 ? 2026 : Number(slider?.value ?? 1784));
    };
    a.addEventListener('mouseenter', hold);
    a.addEventListener('focus', hold);
    a.addEventListener('mouseleave', release);
    a.addEventListener('blur', release);
  });
  let frame = 0;
  let playing = false;
  function render(y: number) {
    if (!slider || !clock || !context || !fig) return;
    slider.value = String(y);
    slider.setAttribute('aria-valuetext', y === 1895 ? 'Native lands today' : String(y));
    clock.textContent = y === 1895 ? 'Today' : String(y);
    context.textContent =
      y === 1895 ? 'Reservations and trust lands today' : 'The historical record of land cessions';
    fig.classList.toggle('show-today', y === 1895);
    // the slider's "Today" stop belongs to the last chapter
    showChapter(y === 1895 ? 2026 : y);
    paths.forEach((p) => p.classList.toggle('ceded', Number(p.dataset.year) <= y));
  }
  function stop() {
    cancelAnimationFrame(frame);
    playing = false;
    if (playButton) {
      playButton.textContent = '▶';
      playButton.setAttribute('aria-label', 'Play land history');
    }
  }
  function play() {
    if (playing) {
      stop();
      return;
    }
    const start = Number(slider?.value ?? 1784) >= 1895 ? 1784 : Number(slider?.value ?? 1784);
    const t0 = performance.now();
    playing = true;
    if (playButton) {
      playButton.textContent = 'Ⅱ';
      playButton.setAttribute('aria-label', 'Pause land history');
    }
    const tick = (t: number) => {
      const y = Math.min(1895, start + Math.floor((t - t0) / 100));
      render(y);
      if (y < 1895) frame = requestAnimationFrame(tick);
      else stop();
    };
    frame = requestAnimationFrame(tick);
  }
  render(1784);
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) play();
  playButton?.addEventListener('click', play);
  slider?.addEventListener('input', () => {
    stop();
    render(Number(slider.value));
  });
  document.addEventListener('visibilitychange', () => {
    if (document.hidden) stop();
  });
  const form = document.getElementById('ask-form') as HTMLFormElement | null;
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const q = (form.elements.namedItem('q') as HTMLInputElement).value.trim();
    if (q.length < 3) return;
    location.href = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/where/#q=${encodeURIComponent(q)}`;
  });
</script>
<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1.13fr;
    gap: 4%;
    align-items: center;
    padding: 68px 0 64px;
  }
  .intro-line {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink-2);
    font-size: 0.78rem;
    margin: 0 0 30px;
  }
  .intro-line > span {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--moss);
    flex: none;
  }
  h1 {
    font-size: clamp(3.7rem, 6.8vw, 6.5rem);
    letter-spacing: -0.065em;
    line-height: 1.01;
    margin: 0 0 28px;
  }
  .hero-description {
    color: var(--ink-2);
    max-width: 36ch;
    font-size: 1.12rem;
    line-height: 1.65;
    margin-bottom: 32px;
  }
  form {
    max-width: 440px;
  }
  form label {
    display: block;
    font-size: 0.85rem;
    margin-bottom: 10px;
  }
  .search-field {
    display: flex;
    align-items: center;
    background: var(--sheet);
    border: 1px solid #c6c7b6;
    border-radius: 9px;
    padding: 6px;
    gap: 10px;
    box-shadow: 0 4px 20px #454b3506;
  }
  .search-field > svg {
    width: 20px;
    height: 20px;
    margin-left: 10px;
    color: var(--ink-2);
    flex: none;
  }
  .search-field input {
    min-width: 0;
    width: 100%;
    background: none;
    border: 0;
    font-size: 0.9rem;
    padding: 8px 0;
  }
  .search-field input::placeholder {
    color: var(--ink-3);
    opacity: 1;
  }
  .search-field button {
    background: var(--moss);
    color: var(--on-moss);
    border: 0;
    border-radius: 6px;
    width: 44px;
    height: 44px;
    flex: none;
    cursor: pointer;
    font-size: 1.45rem;
  }
  .privacy {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.7rem;
    color: var(--ink-3);
    margin-top: 12px;
  }
  .privacy a {
    text-decoration: none;
  }
  .land {
    background: #e4e9db;
    border: 1px solid #d4dcc9;
    border-radius: 20px;
    margin: 0;
    padding: 24px;
    min-width: 0;
  }
  .map-heading {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.75rem;
    color: var(--ink-2);
  }
  .map-heading a {
    text-decoration: none;
  }
  .stage {
    position: relative;
    padding: 38px 0 92px;
  }
  .stage svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .yr {
    fill: #a6b397;
    fill-opacity: 0.7;
    stroke: #859574;
    stroke-width: 0.55;
    stroke-linejoin: round;
    transition: fill-opacity 300ms;
  }
  .yr.ceded {
    fill-opacity: 0.07;
    stroke-opacity: 0.45;
  }
  .today {
    fill: #485d3f;
    stroke: #485d3f;
    stroke-width: 0.5;
    opacity: 0;
    transition: opacity 600ms;
  }
  .show-today .yr {
    fill-opacity: 0.03;
  }
  .show-today .today {
    opacity: 1;
  }
  .map-year {
    position: absolute;
    bottom: 25px;
    left: 0;
    margin: 0;
    font-size: 3.5rem;
    line-height: 1;
    letter-spacing: -0.06em;
    color: #48553e;
    font-variant-numeric: lining-nums tabular-nums;
  }
  .map-context {
    position: absolute;
    bottom: 6px;
    left: 0;
    font-size: 0.7rem;
    color: #59664f;
  }
  .time-controls {
    display: flex;
    gap: 16px;
    align-items: flex-start;
    padding: 16px 0;
    border-top: 1px solid #c9d2bc;
  }
  .time-controls button {
    width: 36px;
    height: 36px;
    border: 1px solid #bfcbb3;
    background: transparent;
    color: #475c3c;
    border-radius: 50%;
    cursor: pointer;
    flex: none;
  }
  .scrubber {
    flex: 1;
    padding-top: 5px;
  }
  .scrubber input {
    width: 100%;
    height: 10px;
    margin: 0;
    accent-color: #485d3f;
    cursor: pointer;
  }
  .time-labels {
    display: flex;
    justify-content: space-between;
    font-size: 0.65rem;
    color: #59664f;
    margin-top: 8px;
  }
  figcaption {
    border-top: 1px solid #c9d2bc;
    padding-top: 16px;
  }
  .keys {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 20px;
    font-size: 0.65rem;
    color: #59664f;
  }
  .keys i {
    display: inline-block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    margin-right: 7px;
  }
  .k-held {
    background: #8b9d78;
  }
  .k-today {
    background: #485d3f;
  }
  figcaption p {
    font-size: 0.65rem;
    line-height: 1.6;
    color: #59664f;
    margin: 10px 0 0;
  }
  .land-col {
    min-width: 0;
  }
  .read-on {
    margin-top: 16px;
  }
  .read-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .ra {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 20px;
    border-radius: 999px;
    font-size: 0.9rem;
    text-decoration: none;
    border: 1px solid #485d3f;
  }
  .ra-map {
    background: #485d3f;
    color: #f6f7f1;
  }
  .ra-story {
    color: #364a2f;
  }
  .ra:hover {
    background: #364a2f;
    border-color: #364a2f;
    color: #f6f7f1;
  }
  .ribbon {
    display: flex;
    gap: 3px;
    list-style: none;
    margin: 22px 0 0;
    padding: 0;
  }
  .ribbon li {
    min-width: 24px;
  }
  /* twelve 24px targets need about 320px; below that the story button stands in for the ribbon */
  @media (max-width: 359px) {
    .ribbon,
    .ribbon-ends,
    .ribbon-now {
      display: none;
    }
  }
  @media (max-width: 1000px) {
    .release {
      margin-top: 24px;
    }
  }
  .ribbon a {
    display: flex;
    align-items: center;
    height: 24px;
  }
  .seg {
    display: block;
    width: 100%;
    height: 8px;
    border-radius: 2px;
    background: #b9c5ab;
    transition:
      height 150ms,
      background-color 150ms;
  }
  .ribbon li:nth-child(even) .seg {
    background: #a6b397;
  }
  .ribbon a.on .seg,
  .ribbon a:hover .seg,
  .ribbon a:focus-visible .seg {
    height: 16px;
    background: #485d3f;
  }
  .ribbon-ends {
    max-width: none;
    display: flex;
    justify-content: space-between;
    gap: 12px;
    margin: 4px 0 0;
    font-size: 0.7rem;
    color: #59664f;
  }
  .ribbon-now {
    margin: 6px 0 0;
    font-size: 0.85rem;
    color: #364a2f;
  }
  .release {
    max-width: none;
    margin: -24px 0 40px;
    font-size: 0.72rem;
    color: var(--ink-3);
  }
  .pathways {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-top: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
    padding: 26px 0;
    gap: 32px;
  }
  .pathways > a {
    display: flex;
    align-items: center;
    gap: 18px;
    text-decoration: none;
    color: var(--ink);
  }
  .pathways > a > span:last-child {
    margin-left: auto;
    color: var(--moss);
  }
  .path-icon {
    font-size: 2rem;
    color: #83916f;
    width: 32px;
    flex: none;
  }
  .pathways strong {
    display: block;
    font-weight: 400;
    font-size: 1rem;
  }
  .pathways small {
    display: block;
    color: var(--ink-2);
    font-size: 0.75rem;
    margin-top: 4px;
  }
  .action-section {
    padding: 88px 0 24px;
  }
  .section-heading {
    display: grid;
    grid-template-columns: 1.35fr 1fr;
    gap: 10%;
    align-items: end;
    margin-bottom: 36px;
  }
  .section-note {
    font-size: 0.8rem;
    color: var(--moss);
    margin-bottom: 16px;
  }
  h2 {
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    letter-spacing: -0.045em;
    line-height: 1.12;
    margin: 0;
  }
  .section-heading > p {
    color: var(--ink-2);
    font-size: 0.95rem;
    margin: 0 0 4px;
  }
  .org-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }
  .action-bottom {
    display: flex;
    gap: 24px;
    justify-content: space-between;
    align-items: center;
    margin-top: 24px;
    font-size: 0.8rem;
  }
  .action-bottom p {
    color: var(--ink-3);
    margin: 0;
  }
  .action-bottom a {
    text-decoration: none;
    white-space: nowrap;
  }
