---
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import NationLand from '../../components/NationLand.astro';
import { byType, nationSlug, type Node } from '../../lib/graph';

export function getStaticPaths() {
  return byType('Nation').map((n) => ({ params: { id: nationSlug(n.id) }, props: { n } }));
}
const { n } = Astro.props as { n: Node };
---

<Base title={n.label}>
  <Record n={n}>
    <NationLand n={n} />
  </Record>
</Base>
