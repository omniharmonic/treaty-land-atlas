---
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import { byType, type Node } from '../../lib/graph';

export function getStaticPaths() {
  return byType('Place')
    .filter((n) => n.id.startsWith('plc-state-'))
    .map((n) => ({ params: { id: n.id.replace(/^plc-/, '') }, props: { n } }));
}
const { n } = Astro.props as { n: Node };
---

<Base
  title={n.label}
  description={`Treaties, Royce cessions, nations and land returns connected to ${n.label}.`}
>
  <Record n={n} kicker="State">
    <p class="small muted">
      Everything here is linked at state level only. The atlas does not look up addresses or
      parcels, and a cession touching a state does not tell you whose land a particular place is.
    </p>
  </Record>
</Base>
