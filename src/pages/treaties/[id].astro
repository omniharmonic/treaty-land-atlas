---
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import { byType, type Node } from '../../lib/graph';
import { href } from '../../lib/href';

export function getStaticPaths() {
  return byType('Instrument').map((n) => ({ params: { id: n.id.toLowerCase() }, props: { n } }));
}
const { n } = Astro.props as { n: Node };
const royce = ((n['royce_cession_numbers'] as string[]) ?? []).map(
  (c) => `geo-royce-${c.toLowerCase()}`,
);
void href;
---

<Base title={n.label}>
  <Record n={n}>
    {royce.length > 0 && (
      <p class="sans small">
        <a href={href(`/map/#sel=${encodeURIComponent(royce[0]!)}`)}>
          See this treaty’s Royce cessions on the map
        </a>
      </p>
    )}
  </Record>
</Base>
