---
import Base from '../../layouts/Base.astro';
import TreatyRecord from '../../components/TreatyRecord.astro';
import { byType, overlayFor, type Node } from '../../lib/graph';
export function getStaticPaths() {
  return byType('Instrument').map((n) => ({ params: { id: n.id.toLowerCase() }, props: { n } }));
}
const { n } = Astro.props as { n: Node };
---

<Base
  title={n.label}
  description={
    overlayFor(n)?.headline ??
    `Explore ${n.label}: the agreement, linked history, land records, sources, and the organizations doing the work today.`
  }
>
  <TreatyRecord {n} />
</Base>
